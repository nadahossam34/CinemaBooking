@model LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="cb-auth-page">
    <div class="cb-auth-card">
        <div class="text-center mb-4">
            <h2>Cine<span class="brand-accent" style="color: var(--cb-pink);">Verse</span></h2>
            <p class="text-muted-cb mb-0">Welcome back! Sign in to continue</p>
        </div>

        <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" placeholder="you@example.com" autocomplete="email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" placeholder="Your password" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-4 form-check">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label text-muted-cb"></label>
            </div>

            <button type="submit" class="btn btn-cb-primary w-100">Sign In</button>

            <p class="text-center text-muted-cb mt-4 mb-0">
                Don't have an account? <a asp-controller="Account" asp-action="Register">Create one</a>
            </p>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
