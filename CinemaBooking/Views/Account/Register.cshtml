@model RegisterViewModel
@{
    Layout = null;
    ViewData["Title"] = "Create Account – StarLight Cinemas";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Create your StarLight Cinemas account to unlock reserved seating, member discounts, and exclusive premieres." />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <link rel="icon" href="~/favicon.ico" />
</head>
<body>

    <!-- ===== HEADER ===== -->
    <header class="sl-header">
        <a href="@Url.Action("Index", "Home")" class="sl-logo">STARLIGHT</a>
        <a href="@Url.Action("Index", "Movies")" class="sl-back-link">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="15 18 9 12 15 6" />
            </svg>
            Back to Movies
        </a>
    </header>

    <!-- ===== MAIN ===== -->
    <main class="sl-main">

        <!-- Registration Card -->
        <div class="sl-card sl-card--register">

            <!-- Brand header with icon + STARLIGHT text -->
            <div class="sl-brand-header">
                <div class="sl-brand-header-icon">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
                <span class="sl-brand-header-text">STARLIGHT</span>
            </div>

            <!-- Heading -->
            <h1 class="sl-card-heading">Create your account</h1>
            <p class="sl-card-subtext">
                Join StarLight Premiere to unlock reserved seating,<br />
                member discounts, and exclusive premieres.
            </p>

            <!-- Validation summary -->
            <div asp-validation-summary="ModelOnly" class="sl-validation-summary"></div>

            <!-- Registration Form -->
            <form asp-controller="Account" asp-action="Register" method="post" novalidate id="registerForm">

                <!-- Full Name -->
                <div class="sl-form-group">
                    <div class="sl-label-row">
                        <label for="Name" class="sl-label">Full Name</label>
                        <span class="sl-label-hint-required">LEGAL NAME</span>
                    </div>
                    <div class="sl-input-wrap">
                        <!-- Person icon -->
                        <svg class="sl-input-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
                            <circle cx="12" cy="7" r="4" />
                        </svg>
                        <input asp-for="Name"
                               id="Name"
                               class="sl-input"
                               type="text"
                               placeholder="Alexander Vance"
                               autocomplete="name" />
                    </div>
                    <span asp-validation-for="Name" class="sl-validation"></span>
                </div>

                <!-- Email Address -->
                <div class="sl-form-group">
                    <div class="sl-label-row">
                        <label for="Email" class="sl-label">Email Address</label>
                        <span class="sl-label-hint-required">REQUIRED</span>
                    </div>
                    <div class="sl-input-wrap">
                        <!-- Envelope icon -->
                        <svg class="sl-input-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="2" y="4" width="20" height="16" rx="2" />
                            <path d="M22 4l-10 8L2 4" />
                        </svg>
                        <input asp-for="Email"
                               id="Email"
                               class="sl-input"
                               type="email"
                               placeholder="you@domain.com"
                               autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email" class="sl-validation"></span>
                </div>

                <!-- Password -->
                <div class="sl-form-group">
                    <div class="sl-label-row">
                        <label for="Password" class="sl-label">Password</label>
                        <span class="sl-label-hint-strong" id="strengthLabel">STRONG</span>
                    </div>
                    <div class="sl-input-wrap">
                        <!-- Lock icon -->
                        <svg class="sl-input-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                        </svg>
                        <input asp-for="Password"
                               id="Password"
                               class="sl-input sl-input-password"
                               type="password"
                               placeholder="Enter your password"
                               autocomplete="new-password" />
                        <!-- Eye toggle -->
                        <button type="button" class="sl-eye-toggle" id="togglePassword" aria-label="Toggle password visibility">
                            <svg id="eyeIconPwd" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                <circle cx="12" cy="12" r="3" />
                            </svg>
                        </button>
                    </div>
                    <!-- Strength bar -->
                    <div class="sl-strength-bar-track">
                        <div class="sl-strength-bar-fill" id="strengthBar"></div>
                    </div>
                    <p class="sl-password-hint">
                        Use 8 or more characters with a mix of letters, numbers &amp; symbols.
                    </p>
                    <span asp-validation-for="Password" class="sl-validation"></span>
                </div>

                <!-- Confirm Password -->
                <div class="sl-form-group">
                    <div class="sl-label-row">
                        <label for="ConfirmPassword" class="sl-label">Confirm Password</label>
                    </div>
                    <div class="sl-input-wrap">
                        <!-- Shield-check icon -->
                        <svg class="sl-input-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                        </svg>
                        <input asp-for="ConfirmPassword"
                               id="ConfirmPassword"
                               class="sl-input sl-input-password sl-input-confirm"
                               type="password"
                               placeholder="Re-enter your password"
                               autocomplete="new-password" />
                        <!-- Confirm check icon (shown when passwords match) -->
                        <span class="sl-confirm-check" id="confirmCheck">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" />
                                <polyline points="22 4 12 14.01 9 11.01" />
                            </svg>
                        </span>
                        <!-- Eye toggle -->
                        <button type="button" class="sl-eye-toggle" id="toggleConfirmPassword" aria-label="Toggle confirm password visibility">
                            <svg id="eyeIconConfirm" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                <circle cx="12" cy="12" r="3" />
                            </svg>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="sl-validation"></span>
                </div>

                <!-- Terms & Privacy -->
                <div class="sl-terms-row">
                    <input type="checkbox" id="termsCheckbox" class="sl-terms-checkbox" />
                    <label for="termsCheckbox" class="sl-terms-text">
                        I agree to the <a href="#">Terms of Service</a> and <a href="#">Privacy Policy</a>, and consent
                        to screening updates.
                    </label>
                </div>

                <!-- Create Account button -->
                <button type="submit" class="sl-btn-signin" id="createAccountBtn">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                         style="width:16px;height:16px;vertical-align:-2px;margin-right:6px;">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                        <circle cx="8.5" cy="7" r="4" />
                        <line x1="20" y1="8" x2="20" y2="14" />
                        <line x1="23" y1="11" x2="17" y2="11" />
                    </svg>
                    Create Account
                </button>
            </form>

            <!-- Benefits row -->
            <div class="sl-benefits">
                <div class="sl-benefit">
                    <span class="sl-benefit-dot sl-benefit-dot--green"></span>
                    <span>Earn Points</span>
                </div>
                <span class="sl-benefit-sep"></span>
                <div class="sl-benefit">
                    <span class="sl-benefit-dot sl-benefit-dot--gold"></span>
                    <span>Pick Any Seat</span>
                </div>
                <span class="sl-benefit-sep"></span>
                <div class="sl-benefit">
                    <span class="sl-benefit-dot sl-benefit-dot--blue"></span>
                    <span>Zero Fees</span>
                </div>
            </div>

            <!-- Login prompt -->
            <p class="sl-login-prompt">
                Already have an account?
                <a asp-controller="Account" asp-action="Login">Login</a>
            </p>
        </div>

    </main>

    <!-- ===== FOOTER ===== -->
    <footer class="sl-footer">
        &copy; 2025 StarLight Cinemas Worldwide, Inc. All rights reserved.
    </footer>

    <!-- ===== Scripts ===== -->
    <script>
        (function () {
            // --- Password visibility toggles ---
            function setupToggle(toggleId, inputId, iconId) {
                var btn = document.getElementById(toggleId);
                var input = document.getElementById(inputId);
                var icon = document.getElementById(iconId);
                if (!btn || !input || !icon) return;
                btn.addEventListener('click', function () {
                    var isPassword = input.type === 'password';
                    input.type = isPassword ? 'text' : 'password';
                    if (isPassword) {
                        icon.innerHTML =
                            '<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24" />' +
                            '<line x1="1" y1="1" x2="23" y2="23" />';
                    } else {
                        icon.innerHTML =
                            '<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />' +
                            '<circle cx="12" cy="12" r="3" />';
                    }
                });
            }
            setupToggle('togglePassword', 'Password', 'eyeIconPwd');
            setupToggle('toggleConfirmPassword', 'ConfirmPassword', 'eyeIconConfirm');

            // --- Password strength indicator ---
            var passwordInput = document.getElementById('Password');
            var strengthBar = document.getElementById('strengthBar');
            var strengthLabel = document.getElementById('strengthLabel');

            if (passwordInput && strengthBar && strengthLabel) {
                passwordInput.addEventListener('input', function () {
                    var val = passwordInput.value;
                    var score = 0;

                    if (val.length >= 6) score++;
                    if (val.length >= 8) score++;
                    if (/[a-z]/.test(val) && /[A-Z]/.test(val)) score++;
                    if (/\d/.test(val)) score++;
                    if (/[^a-zA-Z0-9]/.test(val)) score++;

                    var percent, color, label;
                    if (val.length === 0) {
                        percent = 0; color = 'transparent'; label = 'STRONG';
                        strengthLabel.style.color = '#555';
                    } else if (score <= 1) {
                        percent = 20; color = '#e63232'; label = 'WEAK';
                        strengthLabel.style.color = '#e63232';
                    } else if (score <= 2) {
                        percent = 40; color = '#ff9800'; label = 'FAIR';
                        strengthLabel.style.color = '#ff9800';
                    } else if (score <= 3) {
                        percent = 65; color = '#c9a84c'; label = 'GOOD';
                        strengthLabel.style.color = '#c9a84c';
                    } else {
                        percent = 100; color = '#4caf50'; label = 'STRONG';
                        strengthLabel.style.color = '#4caf50';
                    }

                    strengthBar.style.width = percent + '%';
                    strengthBar.style.backgroundColor = color;
                    strengthLabel.textContent = label;

                    // Also check confirm match
                    checkConfirmMatch();
                });
            }

            // --- Confirm password match check ---
            var confirmInput = document.getElementById('ConfirmPassword');
            var confirmCheck = document.getElementById('confirmCheck');

            function checkConfirmMatch() {
                if (!passwordInput || !confirmInput || !confirmCheck) return;
                var match = confirmInput.value.length > 0 && passwordInput.value === confirmInput.value;
                if (match) {
                    confirmCheck.classList.add('visible');
                } else {
                    confirmCheck.classList.remove('visible');
                }
            }

            if (confirmInput) {
                confirmInput.addEventListener('input', checkConfirmMatch);
            }
        })();
    </script>

    <!-- jQuery validation for ASP.NET unobtrusive validation -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>
