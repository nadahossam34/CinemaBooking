@model DataAccessLayer.ViewModel.CinemaViewModel
@{
    ViewData["Title"] = Model?.Name ?? "Cinema Details";
    var isMallOfEgypt = (Model?.Name ?? "").Contains("Mall of Egypt", StringComparison.OrdinalIgnoreCase) || (Model?.City ?? "").Contains("Giza", StringComparison.OrdinalIgnoreCase);
    var isAlexandria = (Model?.Name ?? "").Contains("Alexandria", StringComparison.OrdinalIgnoreCase) || (Model?.City ?? "").Contains("Alexandria", StringComparison.OrdinalIgnoreCase);

    var imageUrl = isMallOfEgypt
        ? "https://lh3.googleusercontent.com/aida-public/AB6AXuBQEUioXS9YiGUteZkknbx8RVJeeuWQDKxrhyHSusFsnHvB_duO9gFxdP7Mdods-gk8aVsAbW3ivUJt76tKcVfx7bomR7vQZMi7tguYehRKu9vHM5pgAaE7HaNoZ3pw59O678GSLlvBHoK3uxruJbHIzXqh8RS-4oE3ntPRn9y7B2-BFcCNM3WSbAbVJi4wTRTZvwpSUSCgiLphG9dFfCC3jvPLtZFImbl7RZw1QNaYz2VYt_NGUwoA5g"
        : (isAlexandria
            ? "https://lh3.googleusercontent.com/aida-public/AB6AXuAl2HYgjo1dp3k0OMocQyKLK8zVOkAqCbKPpcEOn7HlXxQjAr0Cd623-fyEFrlQebh8AnHr5zFSFBb-Es_hPynE_MtQEG3MdUS0VEcKQh7-Rzmeb7FA-PQotjbrdlNWsBwfdmwhti49xloWpJO7u5PNJxLuUDPaSxoti6vQDar_RUd0wuQtrzK4tsO2LoGNfX-bm2sfZKYVqWvsKTCV4ZXzAMdr3BCSswpgiBgoY0lM-DOvixECO0_QCw"
            : "https://lh3.googleusercontent.com/aida-public/AB6AXuAxt0LzD08cdMfBovFXegMyFuwMFcd8x_sEPGCYXJ7Vq819imBIlU-0IMezu_KIwDjq-WmWyFtR1xFRw4wFR5jL6F5ZbNq59-3y1pZgi2cqJj-L_yQMn0osjKygWVL848wwirWrM41YUZLlIdo5WoPRL0GgocOIeHhuoqtu9JfBewUoik0ZBAvNfUCfAQgnUA0hSh9hOUYqZRm4xshN0BEgS0qfpaagxrtrM8bl0pW7aGzi8EQDghSKZw");

    var badgeLocation = isMallOfEgypt 
        ? "Giza • Mall of Egypt, Wahat Rd" 
        : (isAlexandria ? "Alexandria • Corniche Bay" : "New Cairo • Festival City");
    var phone = isMallOfEgypt ? "+20 (2) 3855-4000" : (isAlexandria ? "+20 (3) 5812-700" : "+20 (2) 2618-9100");
}

<div class="flex flex-col w-full px-gutter-mobile md:px-margin py-space-lg">
    <!-- Back to Cinemas -->
    <div class="mb-space-md">
        <a asp-controller="Cinemas" asp-action="Index" class="inline-flex items-center gap-space-xs text-secondary hover:text-on-surface font-label-md transition-colors">
            <span class="material-symbols-outlined text-[18px]">arrow_back</span>
            <span>Back to All Cinemas</span>
        </a>
    </div>

    <!-- Cinema Hero Header -->
    <div class="relative w-full rounded-2xl overflow-hidden bg-surface-container-low shadow-2xl border border-outline-variant/30 mb-space-lg">
        <div class="relative w-full h-80 md:h-96 overflow-hidden">
            <img class="w-full h-full object-cover" src="@imageUrl" alt="@Model?.Name" />
            <div class="absolute inset-0 bg-gradient-to-t from-surface-container-lowest via-surface-container-lowest/60 to-transparent"></div>
            
            <div class="absolute bottom-space-lg left-space-lg right-space-lg flex flex-col md:flex-row md:items-end justify-between gap-space-md">
                <div class="flex flex-col gap-space-xs">
                    <div class="flex items-center gap-space-xs">
                        <span class="bg-primary-container text-on-primary-container font-label-sm uppercase font-bold px-space-sm py-1 rounded shadow-[0_0_10px_rgba(229,9,20,0.5)]">
                            Flagship Venue
                        </span>
                        <span class="bg-surface-container-lowest/90 backdrop-blur-md text-on-surface font-label-sm uppercase px-space-sm py-1 rounded flex items-center gap-1">
                            <span class="material-symbols-outlined text-primary-container text-[14px]">pin_drop</span>
                            @badgeLocation
                        </span>
                    </div>
                    <h1 class="font-headline-xl text-3xl md:text-5xl text-on-surface font-bold tracking-tight">@Model?.Name</h1>
                    <p class="font-body-md text-secondary max-w-2xl">@Model?.Address</p>
                </div>
                <div class="flex items-center gap-space-sm">
                    <button class="branch-select-btn px-space-lg py-3 bg-surface-container hover:bg-surface-bright text-on-surface rounded-lg font-label-md transition-colors flex items-center gap-2"
                            data-branch-name="@Model?.Name"
                            onclick="handleSelectBranch(this, '@Model?.Name')"
                            type="button">
                        <span class="material-symbols-outlined text-[18px]">bookmark_add</span>
                        <span class="select-label">Select Branch</span>
                    </button>
                    <a asp-controller="Movies" asp-action="Index" class="px-space-lg py-3 bg-primary-container hover:bg-inverse-primary text-on-primary-container font-label-md rounded-lg shadow-[0_0_16px_rgba(229,9,20,0.4)] transition-all flex items-center gap-2">
                        <span class="material-symbols-outlined text-[18px]">confirmation_number</span>
                        <span>Book Showtimes</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Info Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-space-md mb-space-lg">
        <div class="bg-surface-container-low rounded-xl p-space-md flex items-center gap-space-md border border-outline-variant/20 shadow-md">
            <div class="w-12 h-12 rounded-lg bg-primary-container/10 flex items-center justify-center text-primary-container">
                <span class="material-symbols-outlined text-2xl">call</span>
            </div>
            <div>
                <span class="font-label-sm uppercase tracking-wider text-secondary">Guest Concierge</span>
                <p class="font-body-md font-semibold text-on-surface">@phone</p>
            </div>
        </div>
        <div class="bg-surface-container-low rounded-xl p-space-md flex items-center gap-space-md border border-outline-variant/20 shadow-md">
            <div class="w-12 h-12 rounded-lg bg-tertiary/10 flex items-center justify-center text-tertiary">
                <span class="material-symbols-outlined text-2xl">schedule</span>
            </div>
            <div>
                <span class="font-label-sm uppercase tracking-wider text-secondary">Box Office Hours</span>
                <p class="font-body-md font-semibold text-on-surface">Daily: 10:00 AM – 02:00 AM</p>
            </div>
        </div>
        <div class="bg-surface-container-low rounded-xl p-space-md flex items-center gap-space-md border border-outline-variant/20 shadow-md">
            <div class="w-12 h-12 rounded-lg bg-primary/10 flex items-center justify-center text-primary">
                <span class="material-symbols-outlined text-2xl">local_parking</span>
            </div>
            <div>
                <span class="font-label-sm uppercase tracking-wider text-secondary">Parking</span>
                <p class="font-body-md font-semibold text-on-surface">VIP Valet &amp; Reserved Bays</p>
            </div>
        </div>
    </div>

    <!-- Auditorium Formats & Experiences -->
    <div class="bg-surface-container-low rounded-xl p-space-lg border border-outline-variant/20 shadow-lg mb-space-lg">
        <h2 class="font-headline-md text-headline-md text-on-surface mb-space-md flex items-center gap-2">
            <span class="material-symbols-outlined text-primary-container">theaters</span>
            <span>Available Screening Experiences</span>
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-space-md">
            <div class="bg-surface-container rounded-lg p-space-md flex flex-col gap-2">
                <div class="flex items-center justify-between">
                    <span class="font-label-lg font-bold text-primary">IMAX 4K Laser</span>
                    <span class="material-symbols-outlined text-primary text-xl">videocam</span>
                </div>
                <p class="font-body-sm text-secondary">Crystal-clear dual laser projection with next-gen 12-channel immersive acoustic surround sound.</p>
            </div>
            <div class="bg-surface-container rounded-lg p-space-md flex flex-col gap-2">
                <div class="flex items-center justify-between">
                    <span class="font-label-lg font-bold text-on-surface">Dolby Atmos Luxe</span>
                    <span class="material-symbols-outlined text-secondary text-xl">surround_sound</span>
                </div>
                <p class="font-body-sm text-secondary">Multi-dimensional audio that flows all around you with ultra-premium motorized recliner seating.</p>
            </div>
            <div class="bg-surface-container rounded-lg p-space-md flex flex-col gap-2">
                <div class="flex items-center justify-between">
                    <span class="font-label-lg font-bold text-tertiary">VIP Dine-In Lounge</span>
                    <span class="material-symbols-outlined text-tertiary text-xl">wine_bar</span>
                </div>
                <p class="font-body-sm text-secondary">At-seat artisanal dining, handcrafted cocktails, private lounge bar, and plush heated recliners.</p>
            </div>
        </div>
    </div>
</div>
