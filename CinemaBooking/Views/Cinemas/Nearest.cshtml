@model DataAccessLayer.ViewModel.NearestCinemaViewModel
@{
    ViewData["Title"] = "Nearest Cinema";
}

<div class="flex flex-col w-full px-gutter-mobile md:px-margin py-space-lg">
    <!-- Back to Cinemas -->
    <div class="mb-space-md">
        <a asp-controller="Cinemas" asp-action="Index" class="inline-flex items-center gap-space-xs text-secondary hover:text-on-surface font-label-md transition-colors">
            <span class="material-symbols-outlined text-[18px]">arrow_back</span>
            <span>Back to All Cinemas</span>
        </a>
    </div>

    <div class="max-w-3xl mx-auto w-full bg-surface-container-low rounded-2xl p-space-xl border border-outline-variant/30 shadow-2xl">
        <div class="flex items-center gap-space-sm text-primary-container font-label-sm uppercase tracking-wider mb-space-xs">
            <span class="material-symbols-outlined text-[20px]">near_me</span>
            <span>Geolocation Discovery</span>
        </div>
        <h1 class="font-headline-xl text-3xl md:text-4xl text-on-surface font-bold tracking-tight mb-space-sm">
            Nearest StarLight Venue
        </h1>

        @if (Model != null)
        {
            <div class="bg-surface-container rounded-xl p-space-lg border border-primary/20 shadow-lg mt-space-md flex flex-col gap-space-md">
                <div class="flex items-start justify-between">
                    <div>
                        <h2 class="font-headline-md text-2xl font-bold text-on-surface">@Model.Name</h2>
                        <p class="font-body-md text-secondary mt-1">@Model.Address</p>
                    </div>
                    <div class="bg-primary-container/20 text-primary-container border border-primary-container/30 px-3 py-1.5 rounded-lg font-label-md text-center">
                        <span class="text-xl font-bold">@Model.DistanceKm</span> km away
                    </div>
                </div>

                <div class="flex flex-wrap gap-space-sm pt-space-xs">
                    <a asp-controller="Cinemas" asp-action="Details" asp-route-id="@Model.Id"
                       class="px-space-lg py-2.5 bg-primary-container hover:bg-inverse-primary text-on-primary-container font-label-md rounded-lg shadow-md transition-all">
                        View Auditorium Showtimes
                    </a>
                    <a href="https://maps.google.com/?q=@Model.Latitude,@Model.Longitude" target="_blank" rel="noopener noreferrer"
                       class="px-space-md py-2.5 bg-surface-bright hover:bg-surface-container-highest text-on-surface font-label-md rounded-lg transition-colors flex items-center gap-1.5">
                        <span class="material-symbols-outlined text-[16px]">navigation</span>
                        <span>Get Directions</span>
                    </a>
                </div>
            </div>
        }
        else
        {
            <p class="font-body-md text-secondary">
                No nearby cinema could be determined for your location. Please check our cinema directory.
            </p>
            <div class="mt-space-md">
                <a asp-controller="Cinemas" asp-action="Index" class="px-space-lg py-3 bg-primary-container text-on-primary-container rounded-lg font-label-md">
                    Explore All Cinemas
                </a>
            </div>
        }
    </div>
</div>
