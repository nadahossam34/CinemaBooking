@model List<ShowtimeViewModel>
@{
    ViewData["Title"] = "Showtimes & Tickets";
    var dateGroups = Model
        .Where(s => s.StartTime.Year > 1)
        .GroupBy(s => s.StartTime.Date)
        .OrderBy(g => g.Key)
        .ToList();
    var undated = Model.Where(s => s.StartTime.Year <= 1).ToList();
    var isSingleMovie = Model.Select(s => s.MovieId).Distinct().Count() == 1;
    var singleMovieTitle = isSingleMovie ? Model.FirstOrDefault()?.MovieTitle : null;
}

<div class="min-h-screen py-10 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    <!-- Header Section -->
    <div class="mb-8 border-b border-[#242424] pb-6">
        <div class="flex items-center gap-2 text-xs text-gray-400 mb-2">
            <a asp-controller="Home" asp-action="Index" class="hover:text-white transition-colors">HOME</a>
            <span>/</span>
            <a asp-controller="Movies" asp-action="Index" class="hover:text-white transition-colors">MOVIES</a>
            <span>/</span>
            <span class="text-[#e50914] font-semibold">SHOWTIMES</span>
        </div>
        <div class="flex flex-col md:flex-row md:items-end justify-between gap-4">
            <div>
                <h1 class="text-3xl font-extrabold text-white tracking-tight font-['Plus_Jakarta_Sans']">
                    @(isSingleMovie && !string.IsNullOrEmpty(singleMovieTitle) ? singleMovieTitle : "Experience Cinema at StarLight")
                </h1>
                <p class="text-sm text-gray-400 mt-1">
                    Select your preferred date, auditorium format, and screening time to book reserved seats.
                </p>
            </div>
            @if (isSingleMovie && Model.Any())
            {
                <a asp-controller="Movies" asp-action="Details" asp-route-id="@Model.First().MovieId" class="inline-flex items-center gap-1.5 text-xs text-gray-400 hover:text-white bg-[#1a1a1a] border border-[#333] px-3 py-1.5 rounded-lg transition-colors">
                    <span class="material-symbols-outlined text-[16px]">info</span>
                    View Movie Details
                </a>
            }
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="bg-[#141414] border border-[#242424] rounded-2xl p-12 text-center max-w-xl mx-auto shadow-2xl">
            <span class="material-symbols-outlined text-5xl text-gray-600 mb-4">event_busy</span>
            <h3 class="text-xl font-bold text-white mb-2 font-['Plus_Jakarta_Sans']">No Showtimes Found</h3>
            <p class="text-sm text-gray-400 mb-6">There are no upcoming screenings scheduled for this selection right now.</p>
            <a asp-controller="Movies" asp-action="Index" class="inline-flex items-center gap-2 bg-[#e50914] hover:bg-[#b20710] text-white text-sm font-semibold px-5 py-2.5 rounded-xl shadow-[0_0_15px_rgba(229,9,20,0.4)] transition-all">
                <span class="material-symbols-outlined text-[18px]">movie</span>
                Browse Other Movies
            </a>
        </div>
    }
    else
    {
        <!-- Date Selector Pills -->
        @if (dateGroups.Any())
        {
            <div class="flex items-center gap-2 overflow-x-auto pb-4 mb-8 scrollbar-none" id="dateTabs">
                @for (var i = 0; i < dateGroups.Count; i++)
                {
                    var group = dateGroups[i];
                    var isToday = group.Key == DateTime.Today;
                    <button type="button"
                            class="date-tab-btn flex flex-col items-center justify-center min-w-[100px] px-4 py-3 rounded-xl border transition-all cursor-pointer @(i == 0 ? "bg-[#e50914] text-white border-[#e50914] shadow-[0_0_16px_rgba(229,9,20,0.45)] font-bold" : "bg-[#141414] text-gray-300 border-[#262626] hover:bg-[#1f1f1f] hover:text-white font-medium")"
                            data-date-target="date-group-@i">
                        <span class="text-[11px] uppercase tracking-wider opacity-80">@(isToday ? "Today" : group.Key.ToString("ddd"))</span>
                        <span class="text-base font-bold">@group.Key.ToString("d MMM")</span>
                    </button>
                }
            </div>

            <!-- Date Groups -->
            @for (var i = 0; i < dateGroups.Count; i++)
            {
                var group = dateGroups[i];
                var moviesInDate = group.GroupBy(s => s.MovieId).ToList();

                <div class="date-group flex flex-col gap-6 @(i == 0 ? "" : "hidden")" id="date-group-@i">
                    @foreach (var movieGroup in moviesInDate)
                    {
                        var first = movieGroup.First();
                        <div class="bg-[#141414] border border-[#242424] rounded-2xl p-5 sm:p-6 shadow-xl">
                            <div class="flex flex-col sm:flex-row gap-5 items-start">
                                @if (!string.IsNullOrWhiteSpace(first.MoviePosterUrl))
                                {
                                    <img src="@first.MoviePosterUrl" alt="@first.MovieTitle" class="w-20 h-28 object-cover rounded-xl border border-[#333] shadow-md shrink-0 hidden sm:block" />
                                }
                                <div class="flex-1 w-full">
                                    <div class="flex items-center justify-between gap-2 mb-3">
                                        <div>
                                            <h3 class="text-xl font-bold text-white font-['Plus_Jakarta_Sans']">@first.MovieTitle</h3>
                                            <span class="text-xs text-gray-400">Available Screenings</span>
                                        </div>
                                        <span class="px-2.5 py-1 rounded bg-[#222] border border-[#333] text-[11px] text-gray-300 font-semibold uppercase">
                                            @group.Key.ToString("dddd, MMMM d")
                                        </span>
                                    </div>

                                    <!-- Showtimes grid grouped by Cinema -->
                                    @{
                                        var cinemasInMovie = movieGroup.GroupBy(s => s.CinemaName);
                                    }
                                    <div class="flex flex-col gap-4 mt-4">
                                        @foreach (var cinemaGroup in cinemasInMovie)
                                        {
                                            <div class="bg-[#1a1a1a]/80 border border-[#2a2a2a] rounded-xl p-4">
                                                <div class="flex items-center gap-2 text-sm font-semibold text-gray-200 mb-3">
                                                    <span class="material-symbols-outlined text-[18px] text-[#e50914]">theaters</span>
                                                    <span>@cinemaGroup.Key</span>
                                                </div>
                                                <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-2.5">
                                                    @foreach (var s in cinemaGroup.OrderBy(s => s.StartTime))
                                                    {
                                                        <a asp-controller="Seats" asp-action="SelectSeats" asp-route-showtimeId="@s.ShowtimeId"
                                                           class="group/btn flex flex-col items-center justify-center p-3 rounded-xl bg-[#222] hover:bg-[#e50914] border border-[#333] hover:border-[#e50914] transition-all text-decoration-none shadow-sm hover:shadow-[0_0_15px_rgba(229,9,20,0.5)]">
                                                            <span class="text-sm font-bold text-white group-hover/btn:text-white">@s.StartTime.ToString("hh:mm tt")</span>
                                                            <span class="text-[10px] text-gray-400 group-hover/btn:text-white/90">@s.HallName</span>
                                                            <span class="text-[10px] text-[#ff8088] group-hover/btn:text-white font-semibold mt-1">@s.TicketPrice.ToString("0") EGP</span>
                                                        </a>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }

        @if (undated.Any())
        {
            <div class="mt-8 bg-[#141414] border border-[#242424] rounded-2xl p-6">
                <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-400 mb-4">Other Screenings (TBD)</h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
                    @foreach (var s in undated)
                    {
                        <div class="p-4 rounded-xl bg-[#1c1c1c] border border-[#2a2a2a] flex items-center justify-between">
                            <div>
                                <div class="font-semibold text-white">@s.CinemaName</div>
                                <div class="text-xs text-gray-400">@s.HallName &middot; Schedule TBD</div>
                            </div>
                            <a asp-controller="Seats" asp-action="SelectSeats" asp-route-showtimeId="@s.ShowtimeId" class="px-3 py-1.5 bg-[#e50914] hover:bg-[#b20710] text-white text-xs font-semibold rounded-lg transition-colors">
                                Select Seats
                            </a>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@section Scripts {
    <script>
        (function () {
            const tabs = document.querySelectorAll('.date-tab-btn');
            tabs.forEach(btn => {
                btn.addEventListener('click', function () {
                    tabs.forEach(b => {
                        b.classList.remove('bg-[#e50914]', 'text-white', 'border-[#e50914]', 'shadow-[0_0_16px_rgba(229,9,20,0.45)]', 'font-bold');
                        b.classList.add('bg-[#141414]', 'text-gray-300', 'border-[#262626]', 'font-medium');
                    });
                    btn.classList.remove('bg-[#141414]', 'text-gray-300', 'border-[#262626]', 'font-medium');
                    btn.classList.add('bg-[#e50914]', 'text-white', 'border-[#e50914]', 'shadow-[0_0_16px_rgba(229,9,20,0.45)]', 'font-bold');

                    const targetId = btn.getAttribute('data-date-target');
                    document.querySelectorAll('.date-group').forEach(group => {
                        group.classList.toggle('hidden', group.id !== targetId);
                    });
                });
            });
        })();
    </script>
}
