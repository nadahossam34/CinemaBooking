@model List<Showtime>
@{
    ViewData["Title"] = "Showtimes & Schedules";
    Layout = "_AdminLayout";
    var movies = ViewBag.Movies as List<Movie> ?? new List<Movie>();
    var cinemas = ViewBag.Cinemas as List<Cinema> ?? new List<Cinema>();
}

<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
    <div>
        <div class="flex items-center gap-2 text-xs uppercase font-bold text-amber-500 tracking-widest mb-1">
            <span class="w-2 h-2 rounded-full bg-amber-500"></span>
            Scheduling Engine
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-white font-['Plus_Jakarta_Sans'] tracking-tight">
            Showtimes &amp; Schedules
        </h1>
        <p class="text-sm text-gray-400 mt-1">
            Assign movies to auditoriums, schedule screening times, and manage ticket price tiers.
        </p>
    </div>
    <div>
        <button type="button" onclick="document.getElementById('createShowtimeModal').classList.remove('hidden')"
                class="inline-flex items-center gap-2 bg-[#e50914] hover:bg-[#b20710] text-white text-sm font-semibold px-4 py-2.5 rounded-lg shadow-[0_0_16px_rgba(229,9,20,0.4)] transition-all cursor-pointer">
            <span class="material-symbols-outlined text-[18px]">add_circle</span>
            Schedule New Showtime
        </button>
    </div>
</div>

@if (TempData["StatusMessage"] != null)
{
    <div class="mb-6 p-4 rounded-xl bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 text-sm flex items-center gap-2">
        <span class="material-symbols-outlined text-[18px]">check_circle</span>
        <span>@TempData["StatusMessage"]</span>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="mb-6 p-4 rounded-xl bg-[#e50914]/15 border border-[#e50914]/30 text-[#ff8088] text-sm flex items-center gap-2">
        <span class="material-symbols-outlined text-[18px]">error</span>
        <span>@TempData["ErrorMessage"]</span>
    </div>
}

<!-- Showtimes Table Card -->
<div class="bg-[#171717] border border-[#262626] rounded-xl overflow-hidden shadow-xl">
    <div class="p-4 sm:p-6 border-b border-[#242424] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="flex items-center gap-2">
            <span class="text-sm font-bold text-white uppercase tracking-wider">Scheduled Screenings</span>
            <span class="bg-[#242424] text-gray-300 text-xs px-2.5 py-0.5 rounded-full font-mono">@Model.Count entries</span>
        </div>
        <div class="flex items-center gap-3">
            <input type="text" id="showtimeFilter" placeholder="Filter by movie or cinema..."
                   class="bg-[#202020] border border-[#333] rounded-lg px-3 py-1.5 text-xs text-gray-200 placeholder-gray-500 focus:outline-none focus:border-[#e50914]" />
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="py-16 text-center text-gray-500">
            <span class="material-symbols-outlined text-4xl mb-2 text-gray-600 block">event_busy</span>
            No showtimes scheduled. Click "Schedule New Showtime" to assign a movie to an auditorium.
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-gray-300" id="showtimeTable">
                <thead>
                    <tr class="border-b border-[#262626] text-[11px] uppercase tracking-wider text-gray-400 bg-[#141414]">
                        <th class="py-3 px-4 font-semibold">Movie</th>
                        <th class="py-3 px-4 font-semibold">Cinema Venue</th>
                        <th class="py-3 px-4 font-semibold">Auditorium / Hall</th>
                        <th class="py-3 px-4 font-semibold">Date &amp; Time</th>
                        <th class="py-3 px-4 font-semibold">Base Price</th>
                        <th class="py-3 px-4 font-semibold">Bookings</th>
                        <th class="py-3 px-4 font-semibold text-right">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[#202020]">
                    @foreach (var s in Model)
                    {
                        var isUpcoming = s.Date >= DateOnly.FromDateTime(DateTime.Today);
                        var bookingsCount = s.Bookings?.Count ?? 0;
                        var ticketsCount = s.Bookings?.SelectMany(b => b.BookingSeats).Count() ?? 0;

                        <tr class="hover:bg-white/[0.02] transition-colors showtime-row">
                            <td class="py-3 px-4 font-semibold text-white">
                                <div class="flex items-center gap-3">
                                    @if (!string.IsNullOrEmpty(s.Movie?.PosterUrl))
                                    {
                                        <img src="@s.Movie.PosterUrl" alt="@s.Movie.Title" class="w-8 h-11 object-cover rounded shadow shrink-0" />
                                    }
                                    <div>
                                        <div class="font-bold text-white text-sm">@(s.Movie?.Title ?? "Unknown Movie")</div>
                                        <div class="text-[11px] text-gray-400">@(s.Movie?.DurationMinutes > 0 ? $"{s.Movie.DurationMinutes}m" : "")</div>
                                    </div>
                                </div>
                            </td>
                            <td class="py-3 px-4">
                                <div class="text-white text-xs font-semibold">@(s.Cinema?.Name ?? "Cinema")</div>
                                <div class="text-[11px] text-gray-400">@(s.Cinema?.City ?? "")</div>
                            </td>
                            <td class="py-3 px-4">
                                <span class="inline-flex items-center gap-1 bg-[#222] border border-[#333] px-2 py-0.5 rounded text-xs text-gray-200">
                                    <span class="material-symbols-outlined text-[14px] text-amber-400">meeting_room</span>
                                    @(s.Hall?.Name ?? "Hall")
                                </span>
                            </td>
                            <td class="py-3 px-4">
                                <div class="text-xs font-semibold @(isUpcoming ? "text-white" : "text-gray-500")">
                                    @s.Date.ToString("ddd, MMM dd, yyyy")
                                </div>
                                <div class="text-[11px] text-[#e50914] font-bold font-mono">
                                    @s.Time.ToString("h:mm tt")
                                </div>
                            </td>
                            <td class="py-3 px-4 text-xs font-bold text-emerald-400">
                                EGP @s.BasePrice.ToString("N2")
                            </td>
                            <td class="py-3 px-4">
                                <span class="text-xs text-gray-300">
                                    @bookingsCount booking(s) (@ticketsCount tix)
                                </span>
                            </td>
                            <td class="py-3 px-4 text-right">
                                <form asp-controller="Admin" asp-action="DeleteShowtime" asp-route-id="@s.Id" method="post" class="inline"
                                      onsubmit="return confirm('Remove this showtime? Customers will no longer be able to book it.');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="text-xs text-red-400 hover:text-red-300 bg-red-500/10 hover:bg-red-500/20 border border-red-500/30 px-2.5 py-1 rounded transition-colors cursor-pointer">
                                        Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Modal: Schedule New Showtime -->
<div id="createShowtimeModal" class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
    <div class="bg-[#171717] border border-[#2a2a2a] rounded-2xl max-w-lg w-full p-6 shadow-2xl relative">
        <div class="flex items-center justify-between pb-4 mb-4 border-b border-[#262626]">
            <h3 class="text-lg font-bold text-white font-['Plus_Jakarta_Sans'] flex items-center gap-2">
                <span class="material-symbols-outlined text-[#e50914]">calendar_add_on</span>
                Schedule Showtime
            </h3>
            <button type="button" onclick="document.getElementById('createShowtimeModal').classList.add('hidden')"
                    class="text-gray-400 hover:text-white p-1 rounded-lg">
                <span class="material-symbols-outlined text-[20px]">close</span>
            </button>
        </div>

        <form asp-controller="Admin" asp-action="CreateShowtime" method="post" class="flex flex-col gap-4">
            @Html.AntiForgeryToken()

            <!-- Movie Selection -->
            <div>
                <label class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-1.5">Movie</label>
                <select name="movieId" required class="w-full bg-[#202020] border border-[#333] rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-[#e50914]">
                    <option value="">-- Select Movie --</option>
                    @foreach (var m in movies)
                    {
                        <option value="@m.Id">@m.Title (@m.DurationMinutes min)</option>
                    }
                </select>
            </div>

            <!-- Cinema Selection -->
            <div>
                <label class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-1.5">Cinema Location</label>
                <select id="modalCinemaSelect" name="cinemaId" required class="w-full bg-[#202020] border border-[#333] rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-[#e50914]">
                    <option value="">-- Select Cinema --</option>
                    @foreach (var c in cinemas)
                    {
                        <option value="@c.Id">@c.Name (@c.City)</option>
                    }
                </select>
            </div>

            <!-- Hall Selection -->
            <div>
                <label class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-1.5">Auditorium / Hall</label>
                <select id="modalHallSelect" name="hallId" required class="w-full bg-[#202020] border border-[#333] rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-[#e50914]">
                    <option value="">-- Select Cinema First --</option>
                </select>
            </div>

            <!-- Date & Time Row -->
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-1.5">Date</label>
                    <input type="date" name="date" required value="@DateTime.Today.ToString("yyyy-MM-dd")"
                           class="w-full bg-[#202020] border border-[#333] rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-[#e50914]" />
                </div>
                <div>
                    <label class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-1.5">Time</label>
                    <input type="time" name="time" required value="19:30"
                           class="w-full bg-[#202020] border border-[#333] rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-[#e50914]" />
                </div>
            </div>

            <!-- Base Price -->
            <div>
                <label class="block text-xs font-semibold text-gray-300 uppercase tracking-wider mb-1.5">Base Ticket Price (EGP)</label>
                <input type="number" name="basePrice" value="180" step="5" min="50" required
                       class="w-full bg-[#202020] border border-[#333] rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-[#e50914]" />
            </div>

            <div class="pt-4 border-t border-[#262626] flex items-center justify-end gap-3">
                <button type="button" onclick="document.getElementById('createShowtimeModal').classList.add('hidden')"
                        class="px-4 py-2 bg-[#262626] hover:bg-[#303030] text-gray-300 text-sm font-semibold rounded-lg transition-colors">
                    Cancel
                </button>
                <button type="submit"
                        class="px-5 py-2 bg-[#e50914] hover:bg-[#b20710] text-white text-sm font-semibold rounded-lg shadow-[0_0_14px_rgba(229,9,20,0.4)] transition-all">
                    Save Showtime
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const cinemaHallsMap = {
                @foreach (var c in cinemas)
                {
                    <text>
                        "@c.Id": [
                            @foreach (var h in c.Halls)
                            {
                                <text>{ id: @h.Id, name: "@h.Name (@h.SeatCount seats)" },</text>
                            }
                        ],
                    </text>
                }
            };

            const cinemaSelect = document.getElementById('modalCinemaSelect');
            const hallSelect = document.getElementById('modalHallSelect');

            cinemaSelect?.addEventListener('change', function () {
                const cId = this.value;
                hallSelect.innerHTML = '';
                const halls = cinemaHallsMap[cId] || [];
                if (halls.length === 0) {
                    hallSelect.innerHTML = '<option value="">No halls found for this cinema</option>';
                } else {
                    halls.forEach(h => {
                        const opt = document.createElement('option');
                        opt.value = h.id;
                        opt.textContent = h.name;
                        hallSelect.appendChild(opt);
                    });
                }
            });

            // Filter
            const filterInput = document.getElementById('showtimeFilter');
            filterInput?.addEventListener('input', function () {
                const term = this.value.toLowerCase().trim();
                document.querySelectorAll('.showtime-row').forEach(row => {
                    const text = row.textContent.toLowerCase();
                    row.style.display = text.includes(term) ? '' : 'none';
                });
            });
        })();
    </script>
}
