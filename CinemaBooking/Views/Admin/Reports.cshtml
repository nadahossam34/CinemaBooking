@{
    ViewData["Title"] = "Reports & Analytics";
    Layout = "_AdminLayout";
    var totalRev = (decimal)(ViewBag.TotalRevenue ?? 0m);
    var totalTickets = (int)(ViewBag.TotalTickets ?? 0);
    var totalBookings = (int)(ViewBag.TotalBookings ?? 0);
    var cinemaStats = ViewBag.CinemaStats as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
}

<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
    <div>
        <div class="flex items-center gap-2 text-xs uppercase font-bold text-emerald-400 tracking-widest mb-1">
            <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
            Financial Intelligence
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-white font-['Plus_Jakarta_Sans'] tracking-tight">
            Reports &amp; Analytics
        </h1>
        <p class="text-sm text-gray-400 mt-1">
            Aggregated box office performance, attendance trends, and circuit revenue distribution.
        </p>
    </div>
</div>

<!-- Primary Stats -->
<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <div class="bg-[#171717] border border-[#262626] rounded-xl p-6">
        <div class="text-xs uppercase font-semibold text-gray-400 mb-2">Total Gross Revenue</div>
        <div class="text-3xl font-extrabold text-white">EGP @totalRev.ToString("N2")</div>
        <div class="text-xs text-emerald-400 mt-2">Calculated from verified bookings</div>
    </div>
    <div class="bg-[#171717] border border-[#262626] rounded-xl p-6">
        <div class="text-xs uppercase font-semibold text-gray-400 mb-2">Total Tickets Issued</div>
        <div class="text-3xl font-extrabold text-white">@totalTickets</div>
        <div class="text-xs text-blue-400 mt-2">Across all auditorium screenings</div>
    </div>
    <div class="bg-[#171717] border border-[#262626] rounded-xl p-6">
        <div class="text-xs uppercase font-semibold text-gray-400 mb-2">Avg Revenue per Booking</div>
        <div class="text-3xl font-extrabold text-white">
            EGP @(totalBookings > 0 ? (totalRev / totalBookings).ToString("N2") : "0.00")
        </div>
        <div class="text-xs text-purple-400 mt-2">From @totalBookings completed transactions</div>
    </div>
</div>

<!-- Breakdown By Cinema -->
<div class="bg-[#171717] border border-[#262626] rounded-xl p-6">
    <h3 class="text-base font-bold text-white uppercase tracking-wider mb-4">Revenue Breakdown by Cinema Location</h3>
    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-gray-300">
            <thead>
                <tr class="border-b border-[#262626] text-[11px] uppercase tracking-wider text-gray-400">
                    <th class="pb-3 font-semibold">Cinema Venue</th>
                    <th class="pb-3 font-semibold">City</th>
                    <th class="pb-3 font-semibold">Active Showtimes</th>
                    <th class="pb-3 font-semibold">Customer Bookings</th>
                    <th class="pb-3 font-semibold text-right">Gross Revenue</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-[#202020]">
                @foreach (var c in cinemaStats)
                {
                    <tr class="hover:bg-white/[0.02]">
                        <td class="py-3 font-bold text-white">@c.CinemaName</td>
                        <td class="py-3 text-gray-400">@c.City</td>
                        <td class="py-3 text-gray-300">@c.ShowtimesCount</td>
                        <td class="py-3 text-gray-300">@c.BookingsCount</td>
                        <td class="py-3 text-right font-bold text-emerald-400">EGP @(((decimal)c.Revenue).ToString("N2"))</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
