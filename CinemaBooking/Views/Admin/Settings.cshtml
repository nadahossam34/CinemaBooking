@{
    ViewData["Title"] = "System Settings";
    Layout = "_AdminLayout";
}

<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
    <div>
        <div class="flex items-center gap-2 text-xs uppercase font-bold text-gray-400 tracking-widest mb-1">
            <span class="w-2 h-2 rounded-full bg-gray-400"></span>
            Administration Console
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-white font-['Plus_Jakarta_Sans'] tracking-tight">
            System &amp; Circuit Settings
        </h1>
        <p class="text-sm text-gray-400 mt-1">
            Configure TMDB synchronization pipeline, default auditorium pricing tiers, and system policies.
        </p>
    </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <!-- TMDB Sync Settings -->
    <div class="bg-[#171717] border border-[#262626] rounded-xl p-6 flex flex-col justify-between">
        <div>
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-base font-bold text-white flex items-center gap-2">
                    <span class="material-symbols-outlined text-[#e50914]">sync</span>
                    TMDB v3 API Sync Engine
                </h3>
                <span class="bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 text-[10px] font-bold px-2 py-0.5 rounded">
                    Active
                </span>
            </div>
            <p class="text-xs text-gray-400 mb-4 leading-relaxed">
                Connects directly to The Movie Database v3 REST endpoints to auto-retrieve high-res artwork, synopsis, runtime, and certification.
            </p>
            <div class="bg-[#141414] border border-[#222] rounded-lg p-3 text-xs text-gray-300 flex flex-col gap-2">
                <div class="flex justify-between">
                    <span class="text-gray-500">Gateway Latency:</span>
                    <span class="text-emerald-400 font-mono">42ms</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-gray-500">Image Base URL:</span>
                    <span class="text-gray-300 font-mono">https://image.tmdb.org/t/p/w500</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-gray-500">Catalog Sync:</span>
                    <span class="text-gray-300 font-mono">@ViewBag.TotalMovies Movies Verified</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Circuit Inventory Statistics -->
    <div class="bg-[#171717] border border-[#262626] rounded-xl p-6 flex flex-col justify-between">
        <div>
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-base font-bold text-white flex items-center gap-2">
                    <span class="material-symbols-outlined text-purple-400">theaters</span>
                    Auditorium &amp; Seat Inventory
                </h3>
                <span class="bg-purple-500/15 border border-purple-500/30 text-purple-300 text-[10px] font-bold px-2 py-0.5 rounded">
                    Operational
                </span>
            </div>
            <p class="text-xs text-gray-400 mb-4 leading-relaxed">
                Physical screen capacity across all active StarLight flagship multiplexes.
            </p>
            <div class="bg-[#141414] border border-[#222] rounded-lg p-3 text-xs text-gray-300 flex flex-col gap-2">
                <div class="flex justify-between">
                    <span class="text-gray-500">Cinemas Registered:</span>
                    <span class="text-white font-bold">@ViewBag.TotalCinemas Locations</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-gray-500">Total Halls / Auditoriums:</span>
                    <span class="text-white font-bold">@ViewBag.TotalHalls Screens</span>
                </div>
                <div class="flex justify-between">
                    <span class="text-gray-500">Total Bookable Seats:</span>
                    <span class="text-white font-bold">@ViewBag.TotalSeats Seats</span>
                </div>
            </div>
        </div>
    </div>
</div>
