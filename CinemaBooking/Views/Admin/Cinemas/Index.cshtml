@model List<Cinema>
@{
    ViewData["Title"] = "Cinemas & Auditoriums";
    Layout = "_AdminLayout";
}

<div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <!-- Breadcrumb & Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
        <div>
            <div class="flex items-center gap-2 text-xs text-gray-400 mb-1">
                <a href="/Admin/Dashboard" class="hover:text-white transition-colors">ADMIN PORTAL</a>
                <span>/</span>
                <span class="text-[#e50914] font-semibold">CINEMAS &amp; AUDITORIUMS</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-bold text-white tracking-tight font-['Plus_Jakarta_Sans']">Cinemas &amp; Auditoriums</h1>
            <p class="text-sm text-gray-400 mt-1">Manage physical theater locations, hall configurations, and projection capabilities across your circuit.</p>
        </div>
        <div class="flex items-center gap-3">
            <a asp-controller="AdminCinemas" asp-action="Create" class="inline-flex items-center gap-2 bg-[#e50914] hover:bg-[#b20710] text-white text-sm font-semibold px-4 py-2.5 rounded-lg shadow-[0_0_15px_rgba(229,9,20,0.4)] transition-all">
                <span class="material-symbols-outlined text-[18px]">add_location_alt</span>
                Add New Cinema
            </a>
        </div>
    </div>

    @if (TempData["StatusMessage"] != null)
    {
        <div class="mb-6 p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-sm flex items-center gap-3">
            <span class="material-symbols-outlined text-[20px]">check_circle</span>
            <span>@TempData["StatusMessage"]</span>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="mb-6 p-4 rounded-xl bg-red-500/10 border border-red-500/30 text-red-400 text-sm flex items-center gap-3">
            <span class="material-symbols-outlined text-[20px]">error</span>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- Stat Bar -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
        <div class="bg-[#141414] border border-[#242424] rounded-xl p-4 flex items-center gap-4">
            <div class="w-12 h-12 rounded-lg bg-[#e50914]/10 border border-[#e50914]/20 flex items-center justify-center text-[#e50914]">
                <span class="material-symbols-outlined text-[24px]">theater_comedy</span>
            </div>
            <div>
                <div class="text-2xl font-bold text-white font-['Plus_Jakarta_Sans']">@Model.Count</div>
                <div class="text-xs text-gray-400 font-medium">Active Multiplexes</div>
            </div>
        </div>
        <div class="bg-[#141414] border border-[#242424] rounded-xl p-4 flex items-center gap-4">
            <div class="w-12 h-12 rounded-lg bg-blue-500/10 border border-blue-500/20 flex items-center justify-center text-blue-400">
                <span class="material-symbols-outlined text-[24px]">location_city</span>
            </div>
            <div>
                <div class="text-2xl font-bold text-white font-['Plus_Jakarta_Sans']">@Model.Select(c => c.City).Distinct().Count()</div>
                <div class="text-xs text-gray-400 font-medium">Metropolitan Cities</div>
            </div>
        </div>
        <div class="bg-[#141414] border border-[#242424] rounded-xl p-4 flex items-center gap-4">
            <div class="w-12 h-12 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400">
                <span class="material-symbols-outlined text-[24px]">verified</span>
            </div>
            <div>
                <div class="text-2xl font-bold text-white font-['Plus_Jakarta_Sans']">Online</div>
                <div class="text-xs text-gray-400 font-medium">Circuit Sync Status</div>
            </div>
        </div>
    </div>

    <!-- Multiplexes Table -->
    <div class="bg-[#141414] border border-[#242424] rounded-xl overflow-hidden shadow-xl">
        <div class="px-6 py-4 border-b border-[#242424] flex items-center justify-between">
            <h3 class="text-base font-semibold text-white flex items-center gap-2">
                <span class="material-symbols-outlined text-[18px] text-gray-400">domain</span>
                Circuit Locations Directory
            </h3>
            <span class="text-xs text-gray-500">@Model.Count total locations</span>
        </div>

        @if (!Model.Any())
        {
            <div class="py-16 text-center">
                <span class="material-symbols-outlined text-gray-600 text-5xl mb-3">apartment</span>
                <p class="text-gray-400 text-sm">No cinemas registered yet in the database.</p>
                <a asp-controller="AdminCinemas" asp-action="Create" class="mt-4 inline-block text-xs text-[#e50914] hover:underline font-semibold">+ Add First Cinema</a>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm text-gray-300">
                    <thead class="bg-[#191919] text-xs uppercase tracking-wider text-gray-400 border-b border-[#242424]">
                        <tr>
                            <th class="py-3.5 px-6 font-semibold">Cinema / Multiplex</th>
                            <th class="py-3.5 px-6 font-semibold">City</th>
                            <th class="py-3.5 px-6 font-semibold">Address</th>
                            <th class="py-3.5 px-6 font-semibold">GPS Coordinates</th>
                            <th class="py-3.5 px-6 font-semibold text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-[#202020]">
                        @foreach (var cinema in Model)
                        {
                            <tr class="hover:bg-[#1a1a1a] transition-colors">
                                <td class="py-4 px-6">
                                    <div class="flex items-center gap-3">
                                        <div class="w-9 h-9 rounded-lg bg-[#222] border border-[#333] flex items-center justify-center text-gray-300 font-bold text-sm">
                                            @cinema.Name.Substring(0, Math.Min(2, cinema.Name.Length)).ToUpperInvariant()
                                        </div>
                                        <div>
                                            <div class="font-semibold text-white">@cinema.Name</div>
                                            <div class="text-xs text-gray-500">ID: #@cinema.Id</div>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-4 px-6 text-gray-300">
                                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#202020] text-xs text-gray-300 border border-[#303030]">
                                        <span class="material-symbols-outlined text-[13px] text-gray-400">location_on</span>
                                        @cinema.City
                                    </span>
                                </td>
                                <td class="py-4 px-6 text-gray-400 text-xs max-w-xs truncate">@cinema.Address</td>
                                <td class="py-4 px-6 text-gray-500 font-mono text-xs">@cinema.Latitude.ToString("0.0000"), @cinema.Longitude.ToString("0.0000")</td>
                                <td class="py-4 px-6 text-right">
                                    <div class="flex items-center justify-end gap-2">
                                        <a asp-controller="AdminCinemas" asp-action="Edit" asp-route-id="@cinema.Id" class="px-3 py-1.5 rounded-lg bg-[#222] hover:bg-[#2e2e2e] text-xs text-gray-200 font-medium border border-[#333] transition-colors">
                                            Edit
                                        </a>
                                        <form asp-controller="AdminCinemas" asp-action="Delete" asp-route-id="@cinema.Id" method="post" class="inline"
                                              onsubmit="return confirm('Delete @cinema.Name? Associated showtimes and halls may also be affected.');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="px-3 py-1.5 rounded-lg bg-red-500/10 hover:bg-red-500/20 text-xs text-red-400 font-medium border border-red-500/30 transition-colors">
                                                Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
