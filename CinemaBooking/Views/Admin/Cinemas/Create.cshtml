@model CinemaFormViewModel
@{
    ViewData["Title"] = "Add Cinema";
}

<div class="cb-auth-page">
    <div class="mb-4">
        <a class="text-muted-cb small d-inline-block mb-2" asp-controller="Admin" asp-action="Index">&larr; Admin Dashboard</a>
        <h2 class="text-white mb-1">Add Cinema</h2>
        <p class="text-muted-cb mb-0">Enter the details for the new cinema location.</p>
    </div>

    <div class="cb-card">
        <form asp-controller="Cinemas" asp-action="Create" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="mb-3"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" placeholder="e.g. Cineplex Mall" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="City" class="form-label"></label>
                    <input asp-for="City" class="form-control" />
                    <span asp-validation-for="City" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Address" class="form-label"></label>
                    <input asp-for="Address" class="form-control" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Latitude" class="form-label"></label>
                    <input asp-for="Latitude" class="form-control" placeholder="e.g. 30.0444" />
                    <span asp-validation-for="Latitude" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Longitude" class="form-label"></label>
                    <input asp-for="Longitude" class="form-control" placeholder="e.g. 31.2357" />
                    <span asp-validation-for="Longitude" class="text-danger"></span>
                </div>
            </div>

            <button type="submit" class="btn btn-cb-primary">Save Cinema</button>
            <a class="btn btn-cb-secondary" asp-controller="Cinemas" asp-action="Index">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
