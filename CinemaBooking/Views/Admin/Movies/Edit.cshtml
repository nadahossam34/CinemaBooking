@model MovieFormViewModel
@{
    ViewData["Title"] = "Edit Movie";
}

<div class="cb-auth-page">
    <div class="mb-4">
        <a class="text-muted-cb small d-inline-block mb-2" asp-controller="Admin" asp-action="Index">&larr; Admin Dashboard</a>
        <h2 class="text-white mb-1">Edit Movie</h2>
        <p class="text-muted-cb mb-0">Update the details for this movie.</p>
    </div>

    <div class="cb-card">
        <form asp-controller="AdminMovies" asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate>
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ReleaseDate" />
            <input type="hidden" asp-for="OriginalTitle" />
            <input type="hidden" asp-for="Director" />
            <input type="hidden" asp-for="Certification" />
            <input type="hidden" asp-for="VoteAverage" />
            <input type="hidden" asp-for="VoteCount" />
            <input type="hidden" asp-for="Formats" />
            <input type="hidden" asp-for="Locations" />
            <div asp-validation-summary="ModelOnly" class="mb-3"></div>

            <div class="row">
                <div class="col-md-8 mb-3">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="TmdbId" class="form-label"></label>
                    <input asp-for="TmdbId" class="form-control" readonly />
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Genre" class="form-label"></label>
                    <input asp-for="Genre" class="form-control" />
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="DurationMinutes" class="form-label"></label>
                    <input asp-for="DurationMinutes" class="form-control" />
                    <span asp-validation-for="DurationMinutes" class="text-danger"></span>
                </div>
                <div class="col-md-3 mb-3">
                    <label asp-for="Rating" class="form-label"></label>
                    <input asp-for="Rating" class="form-control" />
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="PosterUrl" class="form-label"></label>
                    <input asp-for="PosterUrl" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="TrailerUrl" class="form-label"></label>
                    <input asp-for="TrailerUrl" class="form-control" />
                </div>
            </div>

            <div class="row align-items-center">
                <div class="col-md-6 mb-3">
                    <label asp-for="ReleaseStatus" class="form-label"></label>
                    <input asp-for="ReleaseStatus" class="form-control" />
                </div>
                <div class="col-md-6 mb-3 text-center">
                    @if (!string.IsNullOrWhiteSpace(Model.PosterUrl))
                    {
                        <img src="@Model.PosterUrl" alt="Poster preview" style="max-height:160px; border-radius:10px;" />
                    }
                </div>
            </div>

            <button type="submit" class="btn btn-cb-primary">Save Changes</button>
            <a class="btn btn-cb-secondary" asp-controller="AdminMovies" asp-action="Index">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
