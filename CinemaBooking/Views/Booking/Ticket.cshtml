@model BuisnessLogicLayer.ViewModels.TicketViewModel
@{
    ViewData["Title"] = "Ticket Confirmation - " + Model.TicketNumber;
}

<div class="min-h-screen py-12 px-4 sm:px-6 lg:px-8 max-w-3xl mx-auto flex flex-col items-center">
    
    <!-- Success Banner -->
    <div class="w-full text-center mb-8">
        <div class="w-16 h-16 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 flex items-center justify-center mx-auto mb-3 shadow-[0_0_25px_rgba(16,185,129,0.3)]">
            <span class="material-symbols-outlined text-[32px]">check_circle</span>
        </div>
        <h1 class="text-3xl font-extrabold text-white tracking-tight font-['Plus_Jakarta_Sans']">Booking Confirmed!</h1>
        <p class="text-sm text-gray-400 mt-1">Your seats are locked and your digital admission pass has been issued.</p>
    </div>

    <!-- Luxury Perforated Boarding Pass Ticket -->
    <div class="w-full bg-[#161616] border border-[#2b2b2b] rounded-3xl overflow-hidden shadow-[0_20px_60px_rgba(0,0,0,0.9)] relative">
        
        <!-- Top Ticket Header -->
        <div class="bg-gradient-to-r from-[#1f1212] via-[#1a1414] to-[#141414] p-6 sm:p-8 border-b border-[#282828] flex items-center justify-between">
            <div class="flex items-center gap-3">
                <span class="w-8 h-8 rounded-lg bg-[#e50914] flex items-center justify-center text-white font-bold shadow-[0_0_12px_rgba(229,9,20,0.6)]">
                    ★
                </span>
                <div>
                    <span class="font-extrabold tracking-tight text-base text-white font-['Plus_Jakarta_Sans']">ST<span class="text-[#e50914]">★</span>RLIGHT</span>
                    <span class="text-xs text-gray-400 block font-medium">DIGITAL ADMISSION PASS</span>
                </div>
            </div>
            <div class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 text-xs font-bold uppercase tracking-wider">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                Confirmed &amp; Paid
            </div>
        </div>

        <!-- Main Ticket Body -->
        <div class="p-6 sm:p-8 grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
            
            <!-- Ticket Info (8 cols) -->
            <div class="md:col-span-8 space-y-4">
                <div>
                    <span class="text-[10px] font-bold uppercase tracking-widest text-[#ff8088]">FEATURE PRESENTATION</span>
                    <h2 class="text-2xl font-black text-white font-['Plus_Jakarta_Sans'] mt-0.5 leading-tight">
                        @Model.MovieTitle
                    </h2>
                </div>

                <div class="grid grid-cols-2 gap-4 pt-2 text-xs">
                    <div>
                        <span class="text-gray-400 block">Cinema Multiplex</span>
                        <span class="font-semibold text-white mt-0.5 block text-sm">@Model.CinemaName</span>
                    </div>
                    <div>
                        <span class="text-gray-400 block">Auditorium Hall</span>
                        <span class="font-semibold text-white mt-0.5 block text-sm">@Model.HallName</span>
                    </div>
                    <div>
                        <span class="text-gray-400 block">Date &amp; Showtime</span>
                        <span class="font-semibold text-white mt-0.5 block text-sm">@Model.Showtime</span>
                    </div>
                    <div>
                        <span class="text-gray-400 block">Reserved Seats</span>
                        <span class="font-bold text-[#f59e0b] font-mono mt-0.5 block text-base">@Model.Seats</span>
                    </div>
                </div>

                <div class="border-t border-[#252525] pt-4 flex items-center justify-between">
                    <div>
                        <span class="text-[10px] uppercase tracking-wider text-gray-500 block">Pass Reference</span>
                        <span class="font-mono text-sm font-bold text-gray-300">#@Model.TicketNumber</span>
                    </div>
                    <div class="text-right">
                        <span class="text-[10px] uppercase tracking-wider text-gray-500 block">Total Amount Paid</span>
                        <span class="text-lg font-black text-[#ff8088] font-['Plus_Jakarta_Sans']">@Model.TotalAmount.ToString("0.00") EGP</span>
                    </div>
                </div>
            </div>

            <!-- QR Code Section (4 cols) -->
            <div class="md:col-span-4 flex flex-col items-center justify-center p-5 bg-[#0f0f0f] border border-[#262626] rounded-2xl shadow-inner">
                <div class="bg-white p-2.5 rounded-xl shadow-lg">
                    <img src="@Model.QRCodeImage" alt="Ticket Admission QR Code" class="w-36 h-36 object-contain" />
                </div>
                <span class="text-[10px] uppercase tracking-widest text-gray-500 mt-3 font-mono">SCAN AT USHER STAND</span>
            </div>
        </div>

        <!-- Perforation Tear Line Graphic -->
        <div class="relative w-full py-2 flex items-center justify-between overflow-hidden">
            <div class="w-6 h-6 rounded-full bg-[#0e0e0e] -ml-3 border-r border-[#2b2b2b]"></div>
            <div class="flex-1 border-b border-dashed border-[#333] mx-3"></div>
            <div class="w-6 h-6 rounded-full bg-[#0e0e0e] -mr-3 border-l border-[#2b2b2b]"></div>
        </div>

        <!-- Ticket Footer Instructions -->
        <div class="p-4 sm:px-8 bg-[#121212] flex flex-col sm:flex-row items-center justify-between text-xs text-gray-400 gap-2">
            <span class="flex items-center gap-1.5">
                <span class="material-symbols-outlined text-[16px] text-gray-500">info</span>
                Please arrive 15 minutes prior to scheduled showtime.
            </span>
            <span class="font-mono text-[11px] text-gray-500">Booking ID: @Model.BookingId</span>
        </div>
    </div>

    <!-- Bottom Action CTAs -->
    <div class="flex flex-wrap items-center justify-center gap-4 mt-8 w-full">
        <button type="button" onclick="window.print()" class="px-5 py-2.5 rounded-xl bg-[#222] hover:bg-[#2b2b2b] text-gray-200 text-xs font-semibold border border-[#333] transition-colors flex items-center gap-2 cursor-pointer">
            <span class="material-symbols-outlined text-[16px]">print</span>
            Print / Save Pass
        </button>
        <a asp-controller="Booking" asp-action="MyBookings" class="px-5 py-2.5 rounded-xl bg-[#e50914] hover:bg-[#b20710] text-white text-xs font-semibold shadow-[0_0_15px_rgba(229,9,20,0.4)] transition-all flex items-center gap-2">
            <span class="material-symbols-outlined text-[16px]">confirmation_number</span>
            View in My Bookings
        </a>
        <a asp-controller="Home" asp-action="Index" class="px-5 py-2.5 rounded-xl bg-transparent hover:bg-[#1a1a1a] text-gray-400 hover:text-white text-xs font-semibold transition-colors flex items-center gap-2">
            <span class="material-symbols-outlined text-[16px]">home</span>
            Return to Home
        </a>
    </div>
</div>