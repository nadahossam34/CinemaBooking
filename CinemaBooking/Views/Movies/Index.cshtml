@model IEnumerable<DataAccessLayer.ViewModel.MovieViewModel>
@{
    ViewData["Title"] = "Explore Movies";
    var moviesList = Model?.ToList() ?? new List<DataAccessLayer.ViewModel.MovieViewModel>();
    var initialSearch = (ViewData["InitialSearch"] as string) ?? "";
    var initialGenre = (ViewData["InitialGenre"] as string) ?? "all";
}

<div class="flex flex-col w-full">
    <!-- Subtle Ambient Glow Behind Page Top -->
    <div class="relative w-full overflow-hidden">
        <div
            class="absolute -top-32 left-1/4 w-96 h-96 bg-primary-container/10 rounded-full blur-3xl pointer-events-none">
        </div>
        <div class="absolute -top-24 right-1/4 w-80 h-80 bg-tertiary/5 rounded-full blur-3xl pointer-events-none"></div>
        <div
            class="w-full px-gutter-mobile md:px-margin pt-space-xl pb-space-lg flex flex-col gap-space-lg relative z-10">

            <!-- 1. Page Header -->
            <div
                class="flex flex-col md:flex-row md:items-end justify-between gap-space-md border-b border-surface-variant/30 pb-space-lg">
                <div class="flex flex-col gap-space-xs">
                    <div class="flex items-center gap-space-xs">
                        <span class="inline-block w-2 h-2 rounded-full bg-primary-container animate-pulse"></span>
                        <span
                            class="font-label-sm text-label-sm uppercase tracking-widest text-primary-container">Auditorium
                            Schedule</span>
                        </div>
                        <h1
                            class="font-headline-xl text-headline-xl md:text-display-hero text-on-surface tracking-tight font-extrabold">
                            Explore Movies
                        </h1>
                        <p class="font-body-md text-body-md text-secondary max-w-xl">
                            Discover the latest movies and book your seats across premier screening environments.
                        </p>
                    </div>
                    <div class="flex items-center gap-space-sm self-start md:self-end">
                        <div
                            class="flex items-center gap-space-xs bg-surface-container px-space-md py-space-xs rounded-lg border border-surface-variant/60 shadow-sm">
                            <span class="material-symbols-outlined text-tertiary text-[18px]">verified</span>
                            <span class="font-label-md text-label-md text-on-surface font-semibold"
                                  id="movie-count-badge">Showing @moviesList.Count Titles</span>
                            <span class="text-secondary/40 font-body-sm">•</span>
                            <span class="font-label-sm text-label-sm text-secondary uppercase">IMAX 3D &amp; Dolby
                                Cinema</span>
                            </div>
                        </div>
                    </div>

                    <!-- In-Page Movie Search Bar (Positioned directly below heading & above genre filter pills) -->
                    <div class="w-full pt-space-xs">
                        <div class="relative flex items-center w-full max-w-xl">
                            <span
                            class="material-symbols-outlined absolute left-4 text-secondary/70 pointer-events-none text-[22px]">search</span>
                            <input id="movie-search-input"
                                   class="w-full bg-surface-container border border-surface-variant/70 rounded-xl pl-12 pr-11 py-3 text-on-surface placeholder:text-secondary/60 font-body-md text-body-md focus:outline-none focus:border-primary-container focus:ring-2 focus:ring-primary-container/30 focus:shadow-[0_0_18px_rgba(229,9,20,0.35)] transition-all shadow-md"
                                   placeholder="Search movies by title, genre, or keywords..." type="text"
                                   value="@initialSearch" />
                            <button type="button" id="movie-clear-search-btn"
                                    class="@(string.IsNullOrEmpty(initialSearch) ? "hidden" : "flex") absolute right-3 items-center justify-center w-7 h-7 rounded-lg bg-surface-container-high hover:bg-surface-bright text-secondary hover:text-on-surface transition-colors cursor-pointer"
                                    title="Clear search">
                                <span class="material-symbols-outlined text-[16px]">close</span>
                            </button>
                        </div>
                    </div>

                    <!-- 2. Interactive Filter Bar & Controls -->
                    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-space-md pt-space-xs">
                        <!-- Filter Pills Scrollable Strip -->
                        <div class="flex items-center gap-space-xs overflow-x-auto pb-space-xs scrollbar-none"
                             id="genre-filter-group">
                            <button
                                class="genre-pill whitespace-nowrap bg-primary-container text-on-primary-container shadow-[0_0_16px_rgba(229,9,20,0.35)] font-label-md text-label-md px-space-md py-2 rounded-lg transition-all"
                                data-filter="all" type="button">
                                All Movies
                            </button>
                            <button
                                class="genre-pill whitespace-nowrap bg-surface-container text-secondary hover:text-on-surface hover:border-primary-container/60 border border-surface-variant/70 font-label-md text-label-md px-space-md py-2 rounded-lg transition-all"
                                data-filter="Sci-Fi" type="button">
                                Sci-Fi
                            </button>
                            <button
                                class="genre-pill whitespace-nowrap bg-surface-container text-secondary hover:text-on-surface hover:border-primary-container/60 border border-surface-variant/70 font-label-md text-label-md px-space-md py-2 rounded-lg transition-all"
                                data-filter="Action" type="button">
                                Action
                            </button>
                            <button
                                class="genre-pill whitespace-nowrap bg-surface-container text-secondary hover:text-on-surface hover:border-primary-container/60 border border-surface-variant/70 font-label-md text-label-md px-space-md py-2 rounded-lg transition-all"
                                data-filter="Thriller" type="button">
                                Thriller
                            </button>
                            <button
                                class="genre-pill whitespace-nowrap bg-surface-container text-secondary hover:text-on-surface hover:border-primary-container/60 border border-surface-variant/70 font-label-md text-label-md px-space-md py-2 rounded-lg transition-all"
                                data-filter="Drama" type="button">
                                Drama
                            </button>
                            <button
                                class="genre-pill whitespace-nowrap bg-surface-container text-secondary hover:text-on-surface hover:border-primary-container/60 border border-surface-variant/70 font-label-md text-label-md px-space-md py-2 rounded-lg transition-all"
                                data-filter="Comedy" type="button">
                                Comedy
                            </button>
                            <button
                                class="genre-pill whitespace-nowrap bg-surface-container text-secondary hover:text-on-surface hover:border-primary-container/60 border border-surface-variant/70 font-label-md text-label-md px-space-md py-2 rounded-lg transition-all"
                                data-filter="Horror" type="button">
                                Horror
                            </button>
                            <button
                                class="genre-pill whitespace-nowrap bg-surface-container text-secondary hover:text-on-surface hover:border-primary-container/60 border border-surface-variant/70 font-label-md text-label-md px-space-md py-2 rounded-lg transition-all"
                                data-filter="Animation" type="button">
                                Animation
                            </button>
                        </div>

                        <!-- Sort & Viewing Mode Toggles -->
                        <div class="flex items-center gap-space-sm shrink-0">
                            <div class="relative inline-flex items-center">
                                <span
                                class="material-symbols-outlined absolute left-3 text-secondary text-[18px] pointer-events-none">swap_vert</span>
                                <select
                                    class="bg-surface-container text-on-surface font-label-md text-label-md pl-9 pr-8 py-2 rounded-lg border border-surface-variant/80 focus:border-primary-container focus:outline-none appearance-none cursor-pointer hover:border-secondary transition-colors"
                                    id="sort-selector">
                                    <option value="rating">Sort by: Top Rated</option>
                                    <option value="release">Sort by: Release Date</option>
                                    <option value="title">Sort by: Film Title</option>
                                </select>
                                <span
                                class="material-symbols-outlined absolute right-2 text-secondary text-[16px] pointer-events-none">expand_more</span>
                            </div>
                            <button aria-label="Toggle demo empty state"
                                    class="bg-surface-container hover:bg-surface-container-high border border-surface-variant/80 text-secondary hover:text-on-surface px-space-sm py-2 rounded-lg font-label-md text-label-md flex items-center gap-1 transition-all"
                                    id="view-toggle-demo" title="Toggle Empty State Preview">
                                <span class="material-symbols-outlined text-[18px]">filter_alt_off</span>
                                <span class="hidden sm:inline">Simulate Empty</span>
                            </button>
                        </div>
                    </div>

                    <!-- 3. Movie Grid -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 mt-space-sm transition-all duration-300 w-full gap-space-lg"
                         id="movie-grid">
                        @foreach (var movie in moviesList)
                        {
                            var formatBadge = !string.IsNullOrEmpty(movie.Format) ? movie.Format : "IMAX 3D";
                            var scoreFormatted = movie.Score > 0 ? movie.Score.ToString("0.0",
                        System.Globalization.CultureInfo.InvariantCulture) : "8.8";
                            var ratingLabel = !string.IsNullOrEmpty(movie.AgeRating) ? movie.AgeRating :
                        (!string.IsNullOrEmpty(movie.Rating) ? movie.Rating : "PG-13");
                            var hours = movie.DurationMinutes / 60;
                            var mins = movie.DurationMinutes % 60;
                            var durationFormatted = $"{hours}h {(mins < 10 ? "0" + mins : mins.ToString())}m";
                            var genresList = (movie.Genre ?? "").Split(new[] { '/', ',', '•' },
                        StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

                            <article
                                class="movie-card group bg-surface-container border border-surface-variant/70 hover:border-primary-container/60 rounded-xl overflow-hidden flex flex-col justify-between transition-all duration-300 hover:-translate-y-1.5 hover:shadow-[0_16px_32px_rgba(0,0,0,0.85)]"
                                data-genres="@(movie.Genre ?? "")" data-rating="@scoreFormatted" data-title="@movie.Title"
                                data-release="@movie.Year">
                                <div>
                                    <div class="relative aspect-[4/3] w-full overflow-hidden bg-surface-container-lowest">
                                        <img alt="@movie.Title"
                                             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                                             src="@movie.PosterUrl" loading="lazy" />
                                        <div
                                            class="absolute inset-0 bg-gradient-to-t from-surface-container via-transparent to-black/40 pointer-events-none">
                                        </div>
                                        <div class="absolute top-2 inset-x-2 flex items-center justify-between pointer-events-none">
                                            <span
                                                class="bg-surface-container-lowest/80 backdrop-blur-md text-on-surface font-label-sm text-label-sm uppercase px-2 py-0.5 rounded border border-surface-variant tracking-wider font-bold">
                                                @formatBadge
                                            </span>
                                            <span
                                                class="flex items-center gap-1 bg-surface-container-lowest/90 backdrop-blur-md text-on-surface font-label-sm text-label-sm font-bold px-1.5 py-0.5 rounded border border-surface-variant">
                                                <span class="material-symbols-outlined text-tertiary text-[14px]"
                                                      style="font-variation-settings: 'FILL' 1;">star</span>
                                                @scoreFormatted
                                            </span>
                                        </div>
                                    </div>
                                    <div class="p-space-sm flex flex-col gap-1">
                                        <div class="flex items-center justify-between text-secondary font-label-sm text-label-sm">
                                            <span>@movie.Year</span>
                                            <span class="text-surface-variant">•</span>
                                            <span>@durationFormatted</span>
                                            <span class="text-surface-variant">•</span>
                                            <span class="text-on-surface-variant font-semibold">@ratingLabel</span>
                                        </div>
                                        <h2
                                            class="font-headline-sm text-headline-sm text-on-surface tracking-tight group-hover:text-primary-container transition-colors line-clamp-1 font-bold">
                                            @movie.Title
                                        </h2>
                                        <p class="font-body-sm text-body-sm text-secondary/90 line-clamp-2 leading-relaxed">
                                            @(string.IsNullOrEmpty(movie.Description) ? "Experience this cinematic masterpiece in StarLight's ultra-premium auditoriums." : movie.Description)
                                        </p>
                                        <div class="flex flex-wrap gap-1 mt-0.5">
                                            @foreach (var g in genresList.Take(3))
                                            {
                                                <span
                                                class="bg-surface-container-high text-secondary font-label-sm text-label-sm px-1.5 py-0.5 rounded">@g</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                                <div class="p-space-sm pt-0">
                                    <a asp-controller="Movies" asp-action="Details" asp-route-id="@movie.Id"
                                       class="w-full bg-primary-container hover:bg-[#b20710] text-on-primary-container font-label-md text-label-md py-2 rounded-lg flex items-center justify-center gap-1.5 shadow-[0_0_14px_rgba(229,9,20,0.3)] hover:shadow-[0_0_20px_rgba(229,9,20,0.55)] transition-all active:scale-[0.98]">
                                        <span class="material-symbols-outlined text-[16px]">confirmation_number</span>
                                        <span>Book Now</span>
                                    </a>
                                </div>
                            </article>
                        }
                    </div>

                    <!-- 4. Empty State Preview Container -->
                    <div class="hidden flex-col items-center justify-center bg-surface-container border border-surface-variant/80 rounded-2xl p-space-xl text-center max-w-md mx-auto my-space-xl shadow-[0_12px_36px_rgba(0,0,0,0.7)] transition-all"
                         id="empty-state-card">
                        <div
                            class="w-14 h-14 rounded-full bg-surface-container-high text-secondary/60 flex items-center justify-center mb-space-md border border-surface-variant/50">
                            <span class="material-symbols-outlined text-[32px]">movie_off</span>
                        </div>
                        <h3 class="font-headline-sm text-headline-sm text-on-surface font-bold">No movies found</h3>
                        <p class="font-body-sm text-body-sm text-secondary mt-1 max-w-xs leading-relaxed">
                            We couldn't find any screenings matching your current filter criteria.
                        </p>
                        <button
                            class="mt-space-md bg-surface-container-high hover:bg-surface-bright text-on-surface font-label-md text-label-md px-5 py-2.5 rounded-lg border border-surface-variant transition-colors flex items-center gap-2 cursor-pointer"
                            id="reset-filter-btn" type="button">
                            <span class="material-symbols-outlined text-[16px]">restart_alt</span>
                            <span>Reset Filters</span>
                        </button>
                    </div>

        

                    @section Scripts {
                        <script>
                                        (function () {
                                            const filterButtons = document.querySelectorAll('.genre-pill');
                                            const movieCards = document.querySelectorAll('.movie-card');
                                            const movieGrid = document.getElementById('movie-grid');
                                            const emptyState = document.getElementById('empty-state-card');
                                            const resetBtn = document.getElementById('reset-filter-btn');
                                            const toggleDemoBtn = document.getElementById('view-toggle-demo');
                                            const sortSelector = document.getElementById('sort-selector');
                                            const countBadge = document.getElementById('movie-count-badge');
                                            const movieSearch = document.getElementById('movie-search-input') || document.getElementById('global-search-input');
                                            const clearSearchBtn = document.getElementById('movie-clear-search-btn');

                                            let currentActiveFilter = '@initialGenre' || 'all';
                                            let currentSearchTerm = '@initialSearch'.toLowerCase().trim();

                                            function applyFilters() {
                                                let visibleCount = 0;
                                                const filterNormalized = currentActiveFilter.toLowerCase();

                                                movieCards.forEach(card => {
                                                    const cardGenres = (card.getAttribute('data-genres') || '').toLowerCase();
                                                    const cardTitle = (card.getAttribute('data-title') || '').toLowerCase();

                                                    const matchesGenre = (filterNormalized === 'all') || cardGenres.includes(filterNormalized);
                                                    const matchesSearch = !currentSearchTerm || cardTitle.includes(currentSearchTerm) || cardGenres.includes(currentSearchTerm);

                                                    if (matchesGenre && matchesSearch) {
                                                        card.classList.remove('hidden');
                                                        visibleCount++;
                                                    } else {
                                                        card.classList.add('hidden');
                                                    }
                                                });

                                                if (countBadge) {
                                                    countBadge.textContent = `Showing ${visibleCount} Titles`;
                                                }

                                                if (visibleCount === 0) {
                                                    if (emptyState) {
                                                        emptyState.classList.remove('hidden');
                                                        emptyState.classList.add('flex');
                                                    }
                                                } else {
                                                    if (emptyState) {
                                                        emptyState.classList.add('hidden');
                                                        emptyState.classList.remove('flex');
                                                    }
                                                }
                                            }

                                            function setActiveFilter(filterName) {
                                                currentActiveFilter = filterName;
                                                filterButtons.forEach(btn => {
                                                    const match = btn.getAttribute('data-filter') === filterName;
                                                    if (match) {
                                                        btn.className = 'genre-pill whitespace-nowrap bg-primary-container text-on-primary-container shadow-[0_0_16px_rgba(229,9,20,0.35)] font-label-md text-label-md px-space-md py-2 rounded-lg transition-all';
                                                    } else {
                                                        btn.className = 'genre-pill whitespace-nowrap bg-surface-container text-secondary hover:text-on-surface hover:border-primary-container/60 border border-surface-variant/70 font-label-md text-label-md px-space-md py-2 rounded-lg transition-all';
                                                    }
                                                });
                                                applyFilters();
                                            }

                                            filterButtons.forEach(btn => {
                                                btn.addEventListener('click', () => {
                                                    const f = btn.getAttribute('data-filter');
                                                    setActiveFilter(f);
                                                });
                                            });

                                            if (resetBtn) {
                                                resetBtn.addEventListener('click', () => {
                                                    currentSearchTerm = '';
                                                    if (movieSearch) movieSearch.value = '';
                                                    if (clearSearchBtn) {
                                                        clearSearchBtn.classList.add('hidden');
                                                        clearSearchBtn.classList.remove('flex');
                                                    }
                                                    setActiveFilter('all');
                                                });
                                            }

                                            if (toggleDemoBtn) {
                                                toggleDemoBtn.addEventListener('click', () => {
                                                    const isCurrentlyEmpty = emptyState && !emptyState.classList.contains('hidden');
                                                    if (isCurrentlyEmpty) {
                                                        setActiveFilter('all');
                                                    } else {
                                                        movieCards.forEach(c => c.classList.add('hidden'));
                                                        if (emptyState) {
                                                            emptyState.classList.remove('hidden');
                                                            emptyState.classList.add('flex');
                                                        }
                                                        if (countBadge) {
                                                            countBadge.textContent = 'Showing 0 Titles';
                                                        }
                                                    }
                                                });
                                            }

                                            if (sortSelector) {
                                                sortSelector.addEventListener('change', (e) => {
                                                    const val = e.target.value;
                                                    const cardsArray = Array.from(movieCards);
                                                    cardsArray.sort((a, b) => {
                                                        if (val === 'rating') {
                                                            return parseFloat(b.getAttribute('data-rating') || '0') - parseFloat(a.getAttribute('data-rating') || '0');
                                                        } else if (val === 'release') {
                                                            return parseInt(b.getAttribute('data-release') || '0') - parseInt(a.getAttribute('data-release') || '0');
                                                        } else if (val === 'title') {
                                                            return (a.getAttribute('data-title') || '').localeCompare(b.getAttribute('data-title') || '');
                                                        }
                                                        return 0;
                                                    });
                                                    cardsArray.forEach(c => movieGrid.appendChild(c));
                                                });
                                            }

                                            if (movieSearch) {
                                                movieSearch.addEventListener('input', (e) => {
                                                    currentSearchTerm = e.target.value.toLowerCase().trim();
                                                    if (clearSearchBtn) {
                                                        if (currentSearchTerm) {
                                                            clearSearchBtn.classList.remove('hidden');
                                                            clearSearchBtn.classList.add('flex');
                                                        } else {
                                                            clearSearchBtn.classList.add('hidden');
                                                            clearSearchBtn.classList.remove('flex');
                                                        }
                                                    }
                                                    applyFilters();
                                                });
                                            }

                                            if (clearSearchBtn) {
                                                clearSearchBtn.addEventListener('click', () => {
                                                    if (movieSearch) {
                                                        movieSearch.value = '';
                                                        currentSearchTerm = '';
                                                        clearSearchBtn.classList.add('hidden');
                                                        clearSearchBtn.classList.remove('flex');
                                                        movieSearch.focus();
                                                        applyFilters();
                                                    }
                                                });
                                            }

                                            // Initialize active state based on initial params
                                            if (currentActiveFilter && currentActiveFilter !== 'all') {
                                                setActiveFilter(currentActiveFilter);
                                            } else {
                                                applyFilters();
                                            }
                                        })();
                        </script>
                    }
