@{
    var currentPath = (Context.Request.Path.Value ?? "").ToLowerInvariant();
    var isDashboard = currentPath == "/admin/dashboard" || currentPath == "/admin" || currentPath == "/admin/index";
    var isMovies = currentPath.StartsWith("/adminmovies");
    var isShowtimes = currentPath.StartsWith("/admin/showtimes") || currentPath.StartsWith("/adminshowtimes");
    var isCinemas = currentPath.StartsWith("/admincinemas") || currentPath.StartsWith("/admin/cinemas");
    var isBookings = currentPath.StartsWith("/admin/bookings") || currentPath.StartsWith("/adminbookings");
    var isConcessions = currentPath.StartsWith("/admin/concessions");
    var isReports = currentPath.StartsWith("/admin/reports");
    var isSettings = currentPath.StartsWith("/admin/settings");

    var displayName = User?.Identity?.Name;
    var adminFullName = string.IsNullOrWhiteSpace(displayName) ? "Admin Tarek Mansour" : displayName;
    var initials = adminFullName.Trim().Length >= 2 
        ? adminFullName.Trim().Substring(0, 2).ToUpperInvariant() 
        : adminFullName.Trim().Substring(0, 1).ToUpperInvariant();
}
<!DOCTYPE html>
<html lang="en" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Admin Console") - StarLight Cinemas</title>

    <!-- Google Fonts & Material Symbols -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet" />

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: "class",
            theme: {
                extend: {
                    colors: {
                        sl: {
                            red: "#e50914",
                            redDark: "#b20710",
                            bgDark: "#0e0e0e",
                            cardDark: "#171717",
                            cardHover: "#202020",
                            border: "#282828",
                            borderLight: "#383838",
                            textMuted: "#9ca3af",
                            gold: "#f59e0b"
                        }
                    }
                }
            }
        };
    </script>
    <link rel="stylesheet" href="~/css/starlight.css" asp-append-version="true" />
    <style>
        .admin-nav-item {
            display: inline-flex;
            align-items: center;
            padding: 8px 16px;
            font-size: 14px;
            font-weight: 500;
            border-radius: 8px;
            color: #a3a3a3;
            transition: all 0.2s ease;
            white-space: nowrap;
            text-decoration: none;
        }
        .admin-nav-item:hover {
            color: #ffffff;
            background-color: rgba(255, 255, 255, 0.06);
        }
        .admin-nav-item.is-active {
            background-color: #e50914 !important;
            color: #ffffff !important;
            font-weight: 600;
            box-shadow: 0 0 16px rgba(229, 9, 20, 0.45);
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="bg-[#0e0e0e] text-[#e5e2e1] min-h-screen flex flex-col font-['Inter',sans-serif]">

    <!-- Top Admin Header -->
    <header class="bg-[#141414] border-b border-[#242424] sticky top-0 z-50">
        <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between gap-4">
            
            <!-- Left: Logo & Portal Tag -->
            <div class="flex items-center gap-2 shrink-0">
                <a asp-controller="Admin" asp-action="Index" style="display:flex;align-items:center;gap:8px;text-decoration:none;white-space:nowrap;">
                    <span style="display:flex;align-items:center;justify-content:center;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" fill="#e50914" stroke="#e50914" />
                        </svg>
                    </span>
                    <span style="font-size:16px;font-weight:800;letter-spacing:2px;text-transform:uppercase;color:#ffffff;font-family:'Plus Jakarta Sans',sans-serif;">StarLight</span>
                    <span style="font-size:15px;font-weight:400;letter-spacing:1px;color:#ffffff;margin-right:4px;">Cinemas</span>
                    <span style="font-size:10px;font-weight:800;letter-spacing:0.08em;color:#ffffff;background-color:#e50914;border-radius:4px;padding:3px 7px;margin-left:6px;">ADMIN PORTAL</span>
                </a>
            </div>

            <!-- Center: Search Input -->
            <div class="flex-1 max-w-xl hidden md:block">
                <div class="relative flex items-center">
                    <span class="material-symbols-outlined absolute left-3 text-gray-500 text-[18px]">search</span>
                    <input type="text" id="adminGlobalSearch"
                           placeholder="Search admin records, movies, bookings, showtimes..."
                           class="w-full bg-[#1e1e1e] border border-[#303030] rounded-lg pl-9 pr-4 py-2 text-sm text-gray-200 placeholder-gray-500 focus:outline-none focus:border-[#e50914] focus:ring-1 focus:ring-[#e50914] transition-all" />
                </div>
            </div>

            <!-- Right: Status, Notification, Admin Profile -->
            <div class="flex items-center gap-4 shrink-0">
                <!-- Status Dot -->
                <div class="flex items-center gap-1.5" title="System Operational">
                    <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.8)] animate-pulse"></span>
                </div>



                <!-- Divider -->
                <div class="h-6 w-px bg-[#2a2a2a]"></div>

                <!-- Admin Profile Info -->
                <a asp-controller="Account" asp-action="Profile" class="flex items-center gap-2.5 group text-decoration-none">
                    <div class="w-9 h-9 rounded-full bg-[#2a2a2a] border border-[#3a3a3a] text-[#ff8088] font-bold text-sm flex items-center justify-center group-hover:border-[#e50914] transition-colors">
                        @initials
                    </div>
                    <div class="hidden sm:flex flex-col text-left">
                        <span class="text-xs font-semibold text-gray-200 group-hover:text-white transition-colors leading-tight">@adminFullName</span>
                        <span class="text-[10px] text-gray-400 leading-tight">Administrator</span>
                    </div>
                </a>

                <!-- Quick Exit to Public Site -->
                <a asp-controller="Home" asp-action="Index" class="text-xs text-gray-400 hover:text-white border border-[#333] hover:border-gray-500 px-2.5 py-1.5 rounded-lg transition-colors flex items-center gap-1" title="Go to customer site">
                    <span class="material-symbols-outlined text-[14px]">public</span>
                    <span class="hidden xl:inline">Customer Site</span>
                </a>
            </div>
        </div>

        <!-- Subnavigation Row -->
        <nav class="bg-[#111111] border-t border-[#1f1f1f] overflow-x-auto scrollbar-none">
            <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 py-2 flex items-center gap-1.5 min-w-max">
                <a href="/Admin/Dashboard" class="admin-nav-item @(isDashboard ? "is-active" : "")">
                    <span class="material-symbols-outlined text-[18px] mr-1.5">dashboard</span>
                    Dashboard
                </a>
                <a asp-controller="AdminMovies" asp-action="Index" class="admin-nav-item @(isMovies ? "is-active" : "")">
                    <span class="material-symbols-outlined text-[18px] mr-1.5">movie</span>
                    Movies
                </a>
                <a href="/Admin/Showtimes" class="admin-nav-item @(isShowtimes ? "is-active" : "")">
                    <span class="material-symbols-outlined text-[18px] mr-1.5">calendar_month</span>
                    Showtimes &amp; Schedules
                </a>
                <a asp-controller="AdminCinemas" asp-action="Index" class="admin-nav-item @(isCinemas ? "is-active" : "")">
                    <span class="material-symbols-outlined text-[18px] mr-1.5">theaters</span>
                    Cinemas &amp; Auditoriums
                </a>
                <a href="/Admin/Bookings" class="admin-nav-item @(isBookings ? "is-active" : "")">
                    <span class="material-symbols-outlined text-[18px] mr-1.5">confirmation_number</span>
                    Bookings &amp; Tickets
                </a>
                <a href="/Admin/Concessions" class="admin-nav-item @(isConcessions ? "is-active" : "")">
                    <span class="material-symbols-outlined text-[18px] mr-1.5">fastfood</span>
                    Concessions
                </a>
                <a href="/Admin/Reports" class="admin-nav-item @(isReports ? "is-active" : "")">
                    <span class="material-symbols-outlined text-[18px] mr-1.5">analytics</span>
                    Reports &amp; Analytics
                </a>
                <a href="/Admin/Settings" class="admin-nav-item @(isSettings ? "is-active" : "")">
                    <span class="material-symbols-outlined text-[18px] mr-1.5">settings</span>
                    Settings
                </a>
            </div>
        </nav>
    </header>

    <!-- Main Content Slot -->
    <main class="flex-1 w-full max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 py-6">
        @RenderBody()
    </main>

    <!-- Admin Footer -->
    <footer class="bg-[#111111] border-t border-[#202020] py-4 text-xs text-gray-500 mt-auto">
        <div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-2">
            <div>
                &copy; 2026 StarLight Cinemas Global Entertainment Inc. &middot; Internal Back-Office Console v4.2.1
            </div>
            <div class="flex items-center gap-4">
                <span class="hover:text-gray-300 cursor-pointer">Security Protocols</span>
                <span>&middot;</span>
                <span class="hover:text-gray-300 cursor-pointer">System Logs</span>
                <span>&middot;</span>
                <span class="hover:text-gray-300 cursor-pointer">Helpdesk</span>
            </div>
        </div>
    </footer>

    <!-- Global Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/starlight.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
