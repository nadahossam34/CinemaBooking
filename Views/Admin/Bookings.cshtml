@model List<Booking>
@{
    ViewData["Title"] = "Bookings & Tickets";
    Layout = "_AdminLayout";
}

<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
    <div>
        <div class="flex items-center gap-2 text-xs uppercase font-bold text-blue-400 tracking-widest mb-1">
            <span class="w-2 h-2 rounded-full bg-blue-400"></span>
            Box Office Ledger
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-white font-['Plus_Jakarta_Sans'] tracking-tight">
            Bookings &amp; Tickets
        </h1>
        <p class="text-sm text-gray-400 mt-1">
            Real customer reservations, ticket issuance audit log, and payment confirmation records.
        </p>
    </div>
    <div class="flex items-center gap-3">
        <span class="bg-[#1e1e1e] border border-[#333] px-3 py-1.5 rounded-lg text-xs font-mono text-gray-300">
            @Model.Count Total Reservations
        </span>
    </div>
</div>

<!-- Search Bar & Filters -->
<div class="mb-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div class="max-w-md w-full relative">
        <span class="material-symbols-outlined absolute left-3 top-2.5 text-gray-500 text-[18px]">search</span>
        <input type="text" id="bookingSearchInput" placeholder="Search by reference, customer name, email, or film..."
               class="w-full bg-[#181818] border border-[#2e2e2e] rounded-lg pl-9 pr-4 py-2 text-xs text-gray-200 placeholder-gray-500 focus:outline-none focus:border-[#e50914]" />
    </div>
    <div class="text-xs text-gray-400">
        Showing all verified database booking records.
    </div>
</div>

<!-- Bookings Table Card -->
<div class="bg-[#171717] border border-[#262626] rounded-xl overflow-hidden shadow-xl">
    @if (!Model.Any())
    {
        <div class="py-16 text-center text-gray-500">
            <span class="material-symbols-outlined text-4xl mb-2 text-gray-600 block">confirmation_number</span>
            No customer bookings yet in the database. Customer reservations made via checkout will appear here in real time.
        </div>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="w-full text-left text-sm text-gray-300" id="bookingsTable">
                <thead>
                    <tr class="border-b border-[#262626] text-[11px] uppercase tracking-wider text-gray-400 bg-[#141414]">
                        <th class="py-3 px-4 font-semibold">Reference</th>
                        <th class="py-3 px-4 font-semibold">Customer</th>
                        <th class="py-3 px-4 font-semibold">Film &amp; Screening</th>
                        <th class="py-3 px-4 font-semibold">Seats</th>
                        <th class="py-3 px-4 font-semibold">Total Paid</th>
                        <th class="py-3 px-4 font-semibold">Status</th>
                        <th class="py-3 px-4 font-semibold">Booked Date</th>
                        <th class="py-3 px-4 font-semibold text-right">Action</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-[#202020]">
                    @foreach (var b in Model)
                    {
                        var totalAmount = b.BookingSeats.Sum(bs => bs.PricePaid);
                        var seatLabels = string.Join(", ", b.BookingSeats.Select(bs => $"{bs.Seat?.RowLabel}{bs.Seat?.SeatNumber}"));
                        var isPaid = b.Payment != null || totalAmount > 0;

                        <tr class="hover:bg-white/[0.02] transition-colors booking-row">
                            <td class="py-3 px-4 font-mono font-bold text-xs text-[#ff8088]">
                                #@b.BookingReference
                            </td>
                            <td class="py-3 px-4">
                                <div class="font-bold text-white text-xs">@b.CustomerName</div>
                                <div class="text-[11px] text-gray-400">@b.CustomerEmail</div>
                            </td>
                            <td class="py-3 px-4">
                                <div class="font-bold text-white text-xs">@(b.Showtime?.Movie?.Title ?? "—")</div>
                                <div class="text-[11px] text-gray-400">
                                    @(b.Showtime?.Cinema?.Name ?? "—") &middot; @(b.Showtime?.Hall?.Name ?? "—")
                                </div>
                                <div class="text-[11px] text-amber-400">
                                    @(b.Showtime?.Date.ToString("ddd, MMM d") ?? "") @(b.Showtime?.Time.ToString("h:mm tt") ?? "")
                                </div>
                            </td>
                            <td class="py-3 px-4 text-xs font-semibold text-gray-200">
                                @seatLabels
                            </td>
                            <td class="py-3 px-4 text-xs font-bold text-emerald-400">
                                EGP @totalAmount.ToString("N2")
                            </td>
                            <td class="py-3 px-4">
                                <span class="inline-flex items-center gap-1 bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 text-[10px] font-bold px-2 py-0.5 rounded">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                                    @(isPaid ? "Paid & Confirmed" : "Pending")
                                </span>
                            </td>
                            <td class="py-3 px-4 text-xs text-gray-400">
                                @b.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                            </td>
                            <td class="py-3 px-4 text-right">
                                <a asp-controller="Booking" asp-action="Ticket" asp-route-bookingId="@b.Id" target="_blank"
                                   class="inline-flex items-center gap-1 text-xs text-gray-300 hover:text-white bg-[#222] hover:bg-[#2c2c2c] border border-[#333] px-2.5 py-1 rounded transition-colors">
                                    <span class="material-symbols-outlined text-[14px]">confirmation_number</span>
                                    Ticket
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            const searchInput = document.getElementById('bookingSearchInput');
            searchInput?.addEventListener('input', function () {
                const term = this.value.toLowerCase().trim();
                document.querySelectorAll('.booking-row').forEach(row => {
                    const text = row.textContent.toLowerCase();
                    row.style.display = text.includes(term) ? '' : 'none';
                });
            });
        })();
    </script>
}
