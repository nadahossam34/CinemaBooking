@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    Layout = "_AdminLayout";
}

<!-- Page Title & Header -->
<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-8">
    <div>
        <div class="flex items-center gap-2 text-xs uppercase font-bold text-[#e50914] tracking-widest mb-1">
            <span class="w-2 h-2 rounded-full bg-[#e50914] animate-pulse"></span>
            Executive Overview
        </div>
        <h1 class="text-2xl sm:text-3xl font-extrabold text-white font-['Plus_Jakarta_Sans'] tracking-tight">
            Admin Dashboard
        </h1>
        <p class="text-sm text-gray-400 mt-1">
            Real-time circuit telemetry, ticketing volume, and auditorium performance metrics.
        </p>
    </div>
    <div class="flex items-center gap-3">
        <a asp-controller="AdminMovies" asp-action="Create" class="inline-flex items-center gap-2 bg-[#e50914] hover:bg-[#b20710] text-white text-sm font-semibold px-4 py-2.5 rounded-lg shadow-[0_0_16px_rgba(229,9,20,0.4)] transition-all">
            <span class="material-symbols-outlined text-[18px]">add</span>
            Add Movie
        </a>
        <a href="/Admin/Showtimes" class="inline-flex items-center gap-2 bg-[#1f1f1f] hover:bg-[#282828] text-gray-200 border border-[#333] text-sm font-medium px-4 py-2.5 rounded-lg transition-all">
            <span class="material-symbols-outlined text-[18px]">calendar_add_on</span>
            Schedule Showtime
        </a>
    </div>
</div>

<!-- Primary Telemetry KPI Cards -->
<div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <!-- Total Revenue -->
    <div class="bg-[#171717] border border-[#262626] hover:border-[#e50914]/40 rounded-xl p-5 transition-all">
        <div class="flex items-center justify-between text-gray-400 mb-3">
            <span class="text-xs font-semibold uppercase tracking-wider">Total Revenue</span>
            <span class="w-8 h-8 rounded-lg bg-[#e50914]/15 text-[#e50914] flex items-center justify-center">
                <span class="material-symbols-outlined text-[20px]">payments</span>
            </span>
        </div>
        <div class="text-2xl sm:text-3xl font-extrabold text-white">
            EGP @Model.TotalRevenue.ToString("N2")
        </div>
        <div class="text-xs text-emerald-400 mt-2 flex items-center gap-1">
            <span class="material-symbols-outlined text-[14px]">trending_up</span>
            <span>Real database sales total</span>
        </div>
    </div>

    <!-- Tickets Sold -->
    <div class="bg-[#171717] border border-[#262626] hover:border-[#e50914]/40 rounded-xl p-5 transition-all">
        <div class="flex items-center justify-between text-gray-400 mb-3">
            <span class="text-xs font-semibold uppercase tracking-wider">Tickets Sold</span>
            <span class="w-8 h-8 rounded-lg bg-blue-500/15 text-blue-400 flex items-center justify-center">
                <span class="material-symbols-outlined text-[20px]">confirmation_number</span>
            </span>
        </div>
        <div class="text-2xl sm:text-3xl font-extrabold text-white">
            @Model.TicketsSold
        </div>
        <div class="text-xs text-gray-400 mt-2 flex items-center gap-1">
            <span>From @Model.TotalBookings customer booking(s)</span>
        </div>
    </div>

    <!-- Total Movies -->
    <div class="bg-[#171717] border border-[#262626] hover:border-[#e50914]/40 rounded-xl p-5 transition-all">
        <div class="flex items-center justify-between text-gray-400 mb-3">
            <span class="text-xs font-semibold uppercase tracking-wider">Catalog Movies</span>
            <span class="w-8 h-8 rounded-lg bg-amber-500/15 text-amber-400 flex items-center justify-center">
                <span class="material-symbols-outlined text-[20px]">movie</span>
            </span>
        </div>
        <div class="text-2xl sm:text-3xl font-extrabold text-white">
            @Model.TotalMovies
        </div>
        <div class="text-xs text-gray-400 mt-2 flex items-center gap-1">
            <a asp-controller="AdminMovies" asp-action="Index" class="text-amber-400 hover:underline">Manage catalog &rarr;</a>
        </div>
    </div>

    <!-- Active Flagship Cinemas -->
    <div class="bg-[#171717] border border-[#262626] hover:border-[#e50914]/40 rounded-xl p-5 transition-all">
        <div class="flex items-center justify-between text-gray-400 mb-3">
            <span class="text-xs font-semibold uppercase tracking-wider">Flagship Cinemas</span>
            <span class="w-8 h-8 rounded-lg bg-purple-500/15 text-purple-400 flex items-center justify-center">
                <span class="material-symbols-outlined text-[20px]">theaters</span>
            </span>
        </div>
        <div class="text-2xl sm:text-3xl font-extrabold text-white">
            @Model.TotalCinemas
        </div>
        <div class="text-xs text-gray-400 mt-2 flex items-center gap-1">
            <a asp-controller="AdminCinemas" asp-action="Index" class="text-purple-400 hover:underline">Manage venues &rarr;</a>
        </div>
    </div>
</div>

<!-- Secondary KPI Row -->
<div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-8">
    <div class="bg-[#141414] border border-[#222] rounded-xl p-4 flex items-center gap-4">
        <div class="w-11 h-11 rounded-lg bg-emerald-500/10 text-emerald-400 flex items-center justify-center">
            <span class="material-symbols-outlined text-[24px]">calendar_today</span>
        </div>
        <div>
            <div class="text-lg font-bold text-white">@Model.UpcomingShowtimesCount</div>
            <div class="text-xs text-gray-400">Upcoming Active Showtimes</div>
        </div>
    </div>

    <div class="bg-[#141414] border border-[#222] rounded-xl p-4 flex items-center gap-4">
        <div class="w-11 h-11 rounded-lg bg-cyan-500/10 text-cyan-400 flex items-center justify-center">
            <span class="material-symbols-outlined text-[24px]">group</span>
        </div>
        <div>
            <div class="text-lg font-bold text-white">@Model.TotalUsers</div>
            <div class="text-xs text-gray-400">Registered Customer Accounts</div>
        </div>
    </div>

    <div class="bg-[#141414] border border-[#222] rounded-xl p-4 flex items-center gap-4">
        <div class="w-11 h-11 rounded-lg bg-[#e50914]/10 text-[#e50914] flex items-center justify-center">
            <span class="material-symbols-outlined text-[24px]">shopping_cart</span>
        </div>
        <div>
            <div class="text-lg font-bold text-white">@Model.TotalBookings</div>
            <div class="text-xs text-gray-400">Total Bookings Processed</div>
        </div>
    </div>
</div>

<!-- Main Content Grid: Recent Bookings & Catalog Highlights -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
    <!-- Recent Bookings Table (8 Cols) -->
    <div class="lg:col-span-8 bg-[#171717] border border-[#262626] rounded-xl p-6 flex flex-col justify-between">
        <div>
            <div class="flex items-center justify-between mb-4">
                <div>
                    <h3 class="text-base font-bold text-white font-['Plus_Jakarta_Sans']">Recent Customer Bookings</h3>
                    <p class="text-xs text-gray-400">Live booking activity from customer reservations.</p>
                </div>
                <a href="/Admin/Bookings" class="text-xs text-[#e50914] hover:underline font-semibold flex items-center gap-1">
                    <span>View All</span>
                    <span class="material-symbols-outlined text-[14px]">arrow_forward</span>
                </a>
            </div>

            @if (Model.RecentBookings.Count == 0)
            {
                <div class="py-12 text-center text-gray-500 text-sm">
                    <span class="material-symbols-outlined text-4xl mb-2 text-gray-600 block">event_seat</span>
                    No customer bookings recorded yet. New customer orders will automatically appear here.
                </div>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="w-full text-left text-sm text-gray-300">
                        <thead>
                            <tr class="border-b border-[#262626] text-[11px] uppercase tracking-wider text-gray-400">
                                <th class="pb-3 font-semibold">Ref</th>
                                <th class="pb-3 font-semibold">Customer</th>
                                <th class="pb-3 font-semibold">Movie &amp; Cinema</th>
                                <th class="pb-3 font-semibold">Seats</th>
                                <th class="pb-3 font-semibold text-right">Amount</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-[#202020]">
                            @foreach (var b in Model.RecentBookings)
                            {
                                var seatLabels = string.Join(", ", b.BookingSeats.Select(s => $"{s.Seat?.RowLabel}{s.Seat?.SeatNumber}"));
                                var total = b.BookingSeats.Sum(s => s.PricePaid);
                                <tr class="hover:bg-white/[0.02] transition-colors">
                                    <td class="py-3 font-mono text-xs text-[#ff8088]">
                                        #@b.BookingReference.Substring(0, Math.Min(8, b.BookingReference.Length))
                                    </td>
                                    <td class="py-3">
                                        <div class="font-medium text-white">@b.CustomerName</div>
                                        <div class="text-[11px] text-gray-500">@b.CustomerEmail</div>
                                    </td>
                                    <td class="py-3">
                                        <div class="text-white text-xs font-semibold">@(b.Showtime?.Movie?.Title ?? "Movie")</div>
                                        <div class="text-[11px] text-gray-400">@(b.Showtime?.Cinema?.Name ?? "Cinema") &middot; @(b.Showtime?.Date.ToString("MMM d") ?? "")</div>
                                    </td>
                                    <td class="py-3 text-xs text-gray-300">
                                        @seatLabels
                                    </td>
                                    <td class="py-3 text-right font-bold text-white text-xs">
                                        EGP @total.ToString("N2")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Quick Actions & Catalog Snapshot (4 Cols) -->
    <div class="lg:col-span-4 flex flex-col gap-6">
        <!-- Quick Control Hub -->
        <div class="bg-[#171717] border border-[#262626] rounded-xl p-5">
            <h3 class="text-sm font-bold text-white uppercase tracking-wider mb-4 flex items-center gap-2">
                <span class="material-symbols-outlined text-[#e50914] text-[18px]">tune</span>
                Circuit Quick Actions
            </h3>
            <div class="flex flex-col gap-2">
                <a asp-controller="AdminMovies" asp-action="Create" class="flex items-center justify-between p-3 rounded-lg bg-[#202020] hover:bg-[#282828] text-gray-200 transition-colors">
                    <div class="flex items-center gap-2.5 text-xs font-semibold">
                        <span class="material-symbols-outlined text-[#e50914] text-[18px]">sync</span>
                        <span>Fetch &amp; Add TMDB Movie</span>
                    </div>
                    <span class="material-symbols-outlined text-gray-500 text-[16px]">chevron_right</span>
                </a>
                <a href="/Admin/Showtimes" class="flex items-center justify-between p-3 rounded-lg bg-[#202020] hover:bg-[#282828] text-gray-200 transition-colors">
                    <div class="flex items-center gap-2.5 text-xs font-semibold">
                        <span class="material-symbols-outlined text-amber-400 text-[18px]">schedule</span>
                        <span>Assign Showtimes &amp; Halls</span>
                    </div>
                    <span class="material-symbols-outlined text-gray-500 text-[16px]">chevron_right</span>
                </a>
                <a asp-controller="AdminCinemas" asp-action="Create" class="flex items-center justify-between p-3 rounded-lg bg-[#202020] hover:bg-[#282828] text-gray-200 transition-colors">
                    <div class="flex items-center gap-2.5 text-xs font-semibold">
                        <span class="material-symbols-outlined text-purple-400 text-[18px]">add_location_alt</span>
                        <span>Register Cinema Location</span>
                    </div>
                    <span class="material-symbols-outlined text-gray-500 text-[16px]">chevron_right</span>
                </a>
                <a href="/Admin/Reports" class="flex items-center justify-between p-3 rounded-lg bg-[#202020] hover:bg-[#282828] text-gray-200 transition-colors">
                    <div class="flex items-center gap-2.5 text-xs font-semibold">
                        <span class="material-symbols-outlined text-emerald-400 text-[18px]">finance</span>
                        <span>View Revenue Analytics</span>
                    </div>
                    <span class="material-symbols-outlined text-gray-500 text-[16px]">chevron_right</span>
                </a>
            </div>
        </div>

        <!-- Recent Movies Added -->
        <div class="bg-[#171717] border border-[#262626] rounded-xl p-5 flex-1">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-sm font-bold text-white uppercase tracking-wider">Catalog Snapshot</h3>
                <a asp-controller="AdminMovies" asp-action="Index" class="text-xs text-[#e50914] hover:underline">All Movies</a>
            </div>
            <div class="flex flex-col gap-3">
                @foreach (var m in Model.RecentMovies)
                {
                    <div class="flex items-center gap-3 p-2 rounded-lg bg-[#141414] border border-[#222]">
                        @if (!string.IsNullOrEmpty(m.PosterUrl))
                        {
                            <img src="@m.PosterUrl" alt="@m.Title" class="w-9 h-12 object-cover rounded shadow" />
                        }
                        else
                        {
                            <div class="w-9 h-12 bg-[#262626] rounded flex items-center justify-center text-[10px] text-gray-500">No Art</div>
                        }
                        <div class="flex-1 min-w-0">
                            <div class="text-xs font-bold text-white truncate">@m.Title</div>
                            <div class="text-[11px] text-gray-400 truncate">@m.Genre &middot; @m.DurationMinutes min</div>
                        </div>
                        <span class="text-[10px] bg-[#222] border border-[#333] px-1.5 py-0.5 rounded text-gray-300">
                            @(m.ReleaseStatus ?? "Showing")
                        </span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
