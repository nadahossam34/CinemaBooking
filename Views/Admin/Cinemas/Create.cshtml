@model CinemaFormViewModel
@{
    ViewData["Title"] = "Add New Cinema";
    Layout = "_AdminLayout";
}

<div class="max-w-[1600px] mx-auto px-4 sm:px-6 lg:px-8 py-8">

    <!-- Breadcrumb & Header -->
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
        <div>
            <div class="flex items-center gap-2 text-xs text-gray-400 mb-1">
                <a href="/Admin/Dashboard" class="hover:text-white transition-colors">ADMIN PORTAL</a>
                <span>/</span>
                <a asp-controller="AdminCinemas" asp-action="Index" class="hover:text-white transition-colors">CINEMAS &amp; AUDITORIUMS</a>
                <span>/</span>
                <span class="text-[#e50914] font-semibold">ADD NEW CINEMA</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-bold text-white tracking-tight font-['Plus_Jakarta_Sans']">Add New Cinema</h1>
            <p class="text-sm text-gray-400 mt-1">Register a new physical theater location and configure its circuit details.</p>
        </div>
        <div>
            <a asp-controller="AdminCinemas" asp-action="Index"
               class="inline-flex items-center gap-2 bg-[#1f1f1f] hover:bg-[#282828] text-gray-200 border border-[#333] text-sm font-medium px-4 py-2.5 rounded-lg transition-all">
                <span class="material-symbols-outlined text-[18px]">arrow_back</span>
                Back to Cinemas
            </a>
        </div>
    </div>

    <!-- Form Card -->
    <div class="bg-[#141414] border border-[#242424] rounded-xl shadow-xl overflow-hidden max-w-3xl">

        <!-- Card Header -->
        <div class="px-6 py-5 border-b border-[#242424] flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-[#e50914]/10 border border-[#e50914]/20 flex items-center justify-center text-[#e50914]">
                <span class="material-symbols-outlined text-[20px]">add_location_alt</span>
            </div>
            <div>
                <h2 class="text-base font-semibold text-white">Cinema Location Details</h2>
                <p class="text-xs text-gray-400 mt-0.5">Enter the details for the new cinema location</p>
            </div>
        </div>

        <!-- Form Body -->
        <div class="px-6 py-6">
            <form asp-controller="AdminCinemas" asp-action="Create" method="post" novalidate>
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="mb-5 p-4 rounded-xl bg-red-500/10 border border-red-500/30 text-red-400 text-sm"></div>

                <!-- Cinema Name -->
                <div class="mb-5">
                    <label asp-for="Name"
                           class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2"></label>
                    <input asp-for="Name"
                           placeholder="e.g. StarLight Mall of Egypt"
                           class="w-full bg-[#1a1a1a] border border-[#303030] rounded-lg px-4 py-3 text-sm text-gray-100 placeholder-gray-600 focus:outline-none focus:border-[#e50914] focus:ring-1 focus:ring-[#e50914] transition-all" />
                    <span asp-validation-for="Name" class="text-red-400 text-xs mt-1 block"></span>
                </div>

                <!-- City & Address Row -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-5">
                    <div>
                        <label asp-for="City"
                               class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2"></label>
                        <input asp-for="City"
                               placeholder="e.g. Cairo"
                               class="w-full bg-[#1a1a1a] border border-[#303030] rounded-lg px-4 py-3 text-sm text-gray-100 placeholder-gray-600 focus:outline-none focus:border-[#e50914] focus:ring-1 focus:ring-[#e50914] transition-all" />
                        <span asp-validation-for="City" class="text-red-400 text-xs mt-1 block"></span>
                    </div>
                    <div>
                        <label asp-for="Address"
                               class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2"></label>
                        <input asp-for="Address"
                               placeholder="e.g. 6th of October City, Giza"
                               class="w-full bg-[#1a1a1a] border border-[#303030] rounded-lg px-4 py-3 text-sm text-gray-100 placeholder-gray-600 focus:outline-none focus:border-[#e50914] focus:ring-1 focus:ring-[#e50914] transition-all" />
                        <span asp-validation-for="Address" class="text-red-400 text-xs mt-1 block"></span>
                    </div>
                </div>

                <!-- GPS Coordinates Row -->
                <div class="mb-6">
                    <div class="flex items-center gap-2 text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">
                        <span class="material-symbols-outlined text-[15px]">my_location</span>
                        GPS Coordinates (Optional)
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <div>
                            <label asp-for="Latitude"
                                   class="block text-xs text-gray-500 mb-1.5"></label>
                            <input asp-for="Latitude"
                                   placeholder="e.g. 30.0444"
                                   class="w-full bg-[#1a1a1a] border border-[#303030] rounded-lg px-4 py-3 text-sm text-gray-100 placeholder-gray-600 font-mono focus:outline-none focus:border-[#e50914] focus:ring-1 focus:ring-[#e50914] transition-all" />
                            <span asp-validation-for="Latitude" class="text-red-400 text-xs mt-1 block"></span>
                        </div>
                        <div>
                            <label asp-for="Longitude"
                                   class="block text-xs text-gray-500 mb-1.5"></label>
                            <input asp-for="Longitude"
                                   placeholder="e.g. 31.2357"
                                   class="w-full bg-[#1a1a1a] border border-[#303030] rounded-lg px-4 py-3 text-sm text-gray-100 placeholder-gray-600 font-mono focus:outline-none focus:border-[#e50914] focus:ring-1 focus:ring-[#e50914] transition-all" />
                            <span asp-validation-for="Longitude" class="text-red-400 text-xs mt-1 block"></span>
                        </div>
                    </div>
                </div>

                <!-- Action Buttons -->
                <div class="flex items-center gap-3 pt-4 border-t border-[#242424]">
                    <button type="submit"
                            class="inline-flex items-center gap-2 bg-[#e50914] hover:bg-[#b20710] text-white text-sm font-semibold px-5 py-2.5 rounded-lg shadow-[0_0_15px_rgba(229,9,20,0.4)] transition-all">
                        <span class="material-symbols-outlined text-[18px]">save</span>
                        Save Cinema
                    </button>
                    <a asp-controller="AdminCinemas" asp-action="Index"
                       class="inline-flex items-center gap-2 bg-[#1f1f1f] hover:bg-[#282828] text-gray-300 border border-[#333] text-sm font-medium px-5 py-2.5 rounded-lg transition-all">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
