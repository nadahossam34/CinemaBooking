@model IEnumerable<DataAccessLayer.ViewModel.CinemaViewModel>
@{
    ViewData["Title"] = "Our Cinemas";
    var cinemaList = Model?.ToList() ?? new List<DataAccessLayer.ViewModel.CinemaViewModel>();
}

<div class="flex flex-col w-full">
    <!-- Top Hero Visual Strip / Scrim Header -->
    <div class="relative w-full bg-surface-container-lowest overflow-hidden">
        <!-- Subtle Red Glow Orb Background Accent -->
        <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[700px] h-[280px] bg-primary-container/10 blur-[130px] rounded-full pointer-events-none"></div>
        <div class="w-full px-gutter-mobile md:px-margin pt-space-lg pb-space-md flex flex-col gap-space-md">
            <!-- Breadcrumb & Tag -->
            <div class="flex items-center gap-space-xs text-primary-container font-label-sm uppercase tracking-wider">
                <span class="inline-block w-2 h-2 rounded-full bg-primary-container shadow-[0_0_8px_rgba(229,9,20,0.8)]"></span>
                <span>Auditorium Locations &amp; Flagship Venues</span>
            </div>
            <!-- Main Headline & Quick Stats -->
            <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-space-md">
                <div class="flex flex-col gap-space-xs max-w-2xl">
                    <h1 class="font-headline-xl text-headline-xl text-on-surface tracking-tight">Our Cinemas</h1>
                    <p class="font-body-lg text-body-lg text-secondary">
                        Find a StarLight Cinema near you and explore available showtimes across premier screening environments, cutting-edge IMAX Laser, and luxury lounge auditoriums.
                    </p>
                </div>
                <!-- Status Indicator Pill -->
                <div class="flex items-center gap-space-sm bg-surface-container-low px-space-md py-space-sm rounded-lg shadow-sm self-start lg:self-auto">
                    <span class="material-symbols-outlined text-primary-container text-[18px]">theaters</span>
                    <span class="font-label-md text-label-md text-on-surface">Showing <span class="text-primary-container font-bold" id="cinema-count">@cinemaList.Count</span> Flagship Cinemas</span>
                    <span class="text-secondary-container">•</span>
                    <span class="font-label-sm text-label-sm text-secondary uppercase tracking-wider">28 Premium Screens</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Search & Filter Controls Bar -->
    <section class="w-full px-gutter-mobile md:px-margin py-space-sm">
        <div class="bg-surface-container-low rounded-xl p-space-md shadow-md flex flex-col gap-space-md">
            <!-- Input Row -->
            <div class="grid grid-cols-1 md:grid-cols-12 gap-space-sm">
                <!-- Text Search -->
                <div class="md:col-span-6 lg:col-span-5 relative flex items-center">
                    <span class="material-symbols-outlined absolute left-space-md text-secondary pointer-events-none text-[20px]">search</span>
                    <input class="w-full bg-surface-container text-on-surface placeholder:text-secondary/60 rounded-lg pl-10 pr-space-md py-3 font-body-md text-body-md focus:outline-none focus:bg-surface-bright transition-colors shadow-inner"
                           id="cinema-search"
                           placeholder="Search cinemas or locations…"
                           type="text" />
                </div>
                <!-- City Dropdown -->
                <div class="md:col-span-4 lg:col-span-4 relative flex items-center">
                    <span class="material-symbols-outlined absolute left-space-md text-secondary pointer-events-none text-[20px]">location_on</span>
                    <select class="w-full bg-surface-container text-on-surface rounded-lg pl-10 pr-space-lg py-3 font-body-md text-body-md focus:outline-none focus:bg-surface-bright transition-colors appearance-none cursor-pointer"
                            id="city-filter">
                        <option class="bg-surface-container-high text-on-surface" value="all">All Cities</option>
                        <option class="bg-surface-container-high text-on-surface" value="Cairo">Cairo</option>
                        <option class="bg-surface-container-high text-on-surface" value="Giza">Giza (Mall of Egypt)</option>
                        <option class="bg-surface-container-high text-on-surface" value="New Cairo">New Cairo (Festival City)</option>
                        <option class="bg-surface-container-high text-on-surface" value="Sharm">Sharm El Sheikh (Naama Bay)</option>
                        <option class="bg-surface-container-high text-on-surface" value="Alexandria">Alexandria (Corniche Bay)</option>
                        <option class="bg-surface-container-high text-on-surface" value="6th of October">6th of October City</option>
                    </select>
                    <span class="material-symbols-outlined absolute right-space-md text-secondary pointer-events-none text-[18px]">expand_more</span>
                </div>
                <!-- Simulation & Action Buttons -->
                <div class="md:col-span-2 lg:col-span-3 flex items-center gap-space-xs justify-end">
                    <button class="w-full md:w-auto px-space-md py-3 bg-surface-container text-secondary hover:text-on-surface hover:bg-surface-bright rounded-lg font-label-md text-label-md transition-colors flex items-center justify-center gap-space-xs"
                            id="reset-filter-btn"
                            type="button">
                        <span class="material-symbols-outlined text-[16px]">restart_alt</span>
                        <span>Clear Filters</span>
                    </button>
                    <button class="hidden lg:flex items-center gap-space-xs px-space-sm py-3 bg-surface-container-highest text-secondary hover:text-on-surface rounded-lg font-label-sm text-label-sm uppercase tracking-wider transition-colors"
                            id="simulate-empty-btn"
                            title="Toggle empty state view"
                            type="button">
                        <span class="material-symbols-outlined text-[16px]">visibility</span>
                        <span>Preview Empty</span>
                    </button>
                </div>
            </div>
            <!-- Experience Filter Pills -->
            <div class="flex flex-wrap items-center gap-space-xs pt-space-xs">
                <span class="font-label-sm text-label-sm uppercase tracking-wider text-secondary mr-space-xs">Experience:</span>
                <button class="format-pill px-space-md py-1.5 rounded-full font-label-md text-label-md transition-all bg-primary-container text-on-primary-container shadow-[0_0_12px_rgba(229,9,20,0.4)]"
                        data-format="all"
                        type="button">
                    All Formats
                </button>
                <button class="format-pill px-space-md py-1.5 rounded-full font-label-md text-label-md transition-all bg-surface-container text-secondary hover:text-on-surface hover:bg-surface-bright"
                        data-format="IMAX Laser"
                        type="button">
                    IMAX Laser
                </button>
                <button class="format-pill px-space-md py-1.5 rounded-full font-label-md text-label-md transition-all bg-surface-container text-secondary hover:text-on-surface hover:bg-surface-bright"
                        data-format="Dolby Atmos"
                        type="button">
                    Dolby Atmos
                </button>
                <button class="format-pill px-space-md py-1.5 rounded-full font-label-md text-label-md transition-all bg-surface-container text-secondary hover:text-on-surface hover:bg-surface-bright"
                        data-format="VIP Dine-In Lounge"
                        type="button">
                    VIP Dine-In Lounge
                </button>
                <button class="format-pill px-space-md py-1.5 rounded-full font-label-md text-label-md transition-all bg-surface-container text-secondary hover:text-on-surface hover:bg-surface-bright"
                        data-format="Zero-Gravity Seats"
                        type="button">
                    Zero-Gravity Seats
                </button>
            </div>
        </div>
    </section>

    <!-- Cinema Listings Grid Container -->
    <section class="w-full px-gutter-mobile md:px-margin py-space-md">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-space-lg" id="cinemas-grid">
            @foreach (var cinema in cinemaList)
            {
                var isMallOfEgypt = cinema.Name.Contains("Mall of Egypt", StringComparison.OrdinalIgnoreCase) || cinema.City.Contains("Giza", StringComparison.OrdinalIgnoreCase);
                var isSharmOrAlex = cinema.Name.Contains("Sharm", StringComparison.OrdinalIgnoreCase) || cinema.Name.Contains("Alexandria", StringComparison.OrdinalIgnoreCase) || cinema.City.Contains("Sharm", StringComparison.OrdinalIgnoreCase) || cinema.City.Contains("Alexandria", StringComparison.OrdinalIgnoreCase);
                var isNewCairo = !isMallOfEgypt && !isSharmOrAlex;

                var cardCity = isMallOfEgypt ? "Giza 6th of October" : (isSharmOrAlex ? (cinema.City.Contains("Sharm", StringComparison.OrdinalIgnoreCase) ? "Sharm El Sheikh Sinai" : "Alexandria") : "New Cairo Cairo");
                var cardFormats = isMallOfEgypt 
                    ? "IMAX Laser, Dolby Atmos, VIP Dine-In Lounge, Recliner Seats" 
                    : (isSharmOrAlex ? "VIP Premiere, Dolby Atmos, VIP Dine-In Lounge, Zero-Gravity Seats" : "4K Dual Laser, Dolby Atmos, VIP Dine-In Lounge, Recliner Seats");

                var imageUrl = isMallOfEgypt
                    ? "https://lh3.googleusercontent.com/aida-public/AB6AXuBQEUioXS9YiGUteZkknbx8RVJeeuWQDKxrhyHSusFsnHvB_duO9gFxdP7Mdods-gk8aVsAbW3ivUJt76tKcVfx7bomR7vQZMi7tguYehRKu9vHM5pgAaE7HaNoZ3pw59O678GSLlvBHoK3uxruJbHIzXqh8RS-4oE3ntPRn9y7B2-BFcCNM3WSbAbVJi4wTRTZvwpSUSCgiLphG9dFfCC3jvPLtZFImbl7RZw1QNaYz2VYt_NGUwoA5g"
                    : (isSharmOrAlex
                        ? "https://lh3.googleusercontent.com/aida-public/AB6AXuAl2HYgjo1dp3k0OMocQyKLK8zVOkAqCbKPpcEOn7HlXxQjAr0Cd623-fyEFrlQebh8AnHr5zFSFBb-Es_hPynE_MtQEG3MdUS0VEcKQh7-Rzmeb7FA-PQotjbrdlNWsBwfdmwhti49xloWpJO7u5PNJxLuUDPaSxoti6vQDar_RUd0wuQtrzK4tsO2LoGNfX-bm2sfZKYVqWvsKTCV4ZXzAMdr3BCSswpgiBgoY0lM-DOvixECO0_QCw"
                        : "https://lh3.googleusercontent.com/aida-public/AB6AXuAxt0LzD08cdMfBovFXegMyFuwMFcd8x_sEPGCYXJ7Vq819imBIlU-0IMezu_KIwDjq-WmWyFtR1xFRw4wFR5jL6F5ZbNq59-3y1pZgi2cqJj-L_yQMn0osjKygWVL848wwirWrM41YUZLlIdo5WoPRL0GgocOIeHhuoqtu9JfBewUoik0ZBAvNfUCfAQgnUA0hSh9hOUYqZRm4xshN0BEgS0qfpaagxrtrM8bl0pW7aGzi8EQDghSKZw");

                var tagLabel = isMallOfEgypt ? "Flagship" : (isSharmOrAlex ? "Resort VIP" : "Auditorium Luxe");
                var tagClass = isMallOfEgypt 
                    ? "bg-primary-container text-on-primary-container shadow-[0_0_10px_rgba(229,9,20,0.5)]" 
                    : (isSharmOrAlex ? "bg-surface-container-highest text-tertiary-fixed-dim" : "bg-surface-container-highest text-on-surface");

                var badgeLocation = isMallOfEgypt 
                    ? "Giza • Mall of Egypt, Wahat Rd" 
                    : (isSharmOrAlex ? $"{cinema.City} • {cinema.Address}" : "New Cairo • Festival City");

                var phone = isMallOfEgypt ? "+20 (2) 3855-4000" : (isSharmOrAlex ? "+20 (69) 360-1200" : "+20 (2) 2618-9100");
                var hours = isMallOfEgypt ? "Daily: 10:00 AM – 02:00 AM" : (isSharmOrAlex ? "Daily: 11:00 AM – 02:00 AM" : "Daily: 10:30 AM – 01:30 AM");

                <article class="bg-surface-container-low rounded-xl overflow-hidden shadow-lg hover:shadow-2xl hover:-translate-y-1 transition-all duration-300 flex flex-col group"
                         data-cinema-card=""
                         data-city="@cardCity"
                         data-formats="@cardFormats"
                         data-name="@cinema.Name">
                    <!-- Card Header Image Container with Scrim -->
                    <div class="relative w-full aspect-[16/10] overflow-hidden bg-surface-container-high">
                        <img class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                             src="@imageUrl"
                             alt="@cinema.Name Flagship Auditorium" />
                        <div class="absolute inset-0 bg-gradient-to-t from-surface-container-low via-surface-container-low/30 to-transparent"></div>
                        <!-- Top Floating City/Status Tag -->
                        <div class="absolute top-space-sm left-space-sm flex items-center gap-space-xs">
                            <span class="bg-surface-container-lowest/90 backdrop-blur-md text-on-surface font-label-sm text-label-sm uppercase px-space-sm py-1 rounded tracking-wide shadow-sm flex items-center gap-1">
                                <span class="material-symbols-outlined text-primary-container text-[14px]">pin_drop</span>
                                @badgeLocation
                            </span>
                        </div>
                        <!-- Feature Tag Right -->
                        <div class="absolute top-space-sm right-space-sm">
                            <span class="@tagClass font-label-sm text-label-sm uppercase font-bold px-space-sm py-1 rounded">
                                @tagLabel
                            </span>
                        </div>
                    </div>

                    <!-- Card Body -->
                    <div class="p-space-lg flex-1 flex flex-col justify-between gap-space-md bg-surface-container-low">
                        <div class="flex flex-col gap-space-xs">
                            <h2 class="font-headline-md text-headline-md text-on-surface group-hover:text-primary transition-colors">
                                @cinema.Name
                            </h2>
                            <div class="flex items-start gap-space-xs text-secondary font-body-sm text-body-sm">
                                <span class="material-symbols-outlined text-[18px] text-secondary mt-0.5 shrink-0">location_on</span>
                                <span>@cinema.Address</span>
                            </div>
                            <div class="flex items-center flex-wrap gap-x-space-md gap-y-1 text-secondary font-body-sm text-body-sm mt-space-xs pt-space-xs">
                                <div class="flex items-center gap-space-xs">
                                    <span class="material-symbols-outlined text-[16px] text-primary-container">call</span>
                                    <span>@phone</span>
                                </div>
                                <div class="flex items-center gap-space-xs">
                                    <span class="material-symbols-outlined text-[16px] text-tertiary">schedule</span>
                                    <span>@hours</span>
                                </div>
                            </div>
                        </div>

                        <!-- Amenities Grid Badges -->
                        <div class="flex flex-col gap-space-xs pt-space-xs">
                            <span class="font-label-sm text-label-sm uppercase tracking-wider text-secondary/70">Auditorium Amenities</span>
                            <div class="flex flex-wrap gap-1.5">
                                @if (isMallOfEgypt)
                                {
                                    <span class="inline-flex items-center gap-1 bg-surface-container text-primary px-2.5 py-1 rounded font-label-sm text-label-sm uppercase tracking-wider font-semibold shadow-sm">
                                        <span class="material-symbols-outlined text-[14px]">videocam</span>
                                        IMAX Laser
                                    </span>
                                    <span class="inline-flex items-center gap-1 bg-surface-container text-secondary px-2 py-1 rounded font-label-sm text-label-sm">
                                        <span class="material-symbols-outlined text-[14px]">surround_sound</span>
                                        Dolby Atmos
                                    </span>
                                    <span class="inline-flex items-center gap-1 bg-surface-container text-secondary px-2 py-1 rounded font-label-sm text-label-sm">
                                        <span class="material-symbols-outlined text-[14px]">airline_seat_recline_extra</span>
                                        Recliner Seats
                                    </span>
                                    <span class="inline-flex items-center gap-1 bg-surface-container text-secondary px-2 py-1 rounded font-label-sm text-label-sm">
                                        <span class="material-symbols-outlined text-[14px]">wine_bar</span>
                                        VIP Lounge
                                    </span>
                                    <span class="inline-flex items-center gap-1 bg-surface-container text-secondary px-2 py-1 rounded font-label-sm text-label-sm">
                                        <span class="material-symbols-outlined text-[14px]">fastfood</span>
                                        Food &amp; Drinks
                                    </span>
                                    <span class="inline-flex items-center gap-1 bg-surface-container text-secondary px-2 py-1 rounded font-label-sm text-label-sm">
                                        <span class="material-symbols-outlined text-[14px]">local_parking</span>
                                        Parking
                                    </span>
                                }
                                else if (isSharmOrAlex)
                                {
                                    <span class="inline-flex items-center gap-1 bg-surface-container text-primary px-2.5 py-1 rounded font-label-sm text-label-sm uppercase tracking-wider font-semibold shadow-sm">
                                        <span class="material-symbols-outlined text-[14px]">diamond</span>
                                        VIP Premiere
                                    </span>
                                    <span class="inline-flex items-center gap-1 bg-surface-container text-secondary px-2 py-1 rounded font-label-sm text-label-sm">
                                        <span class="material-symbols-outlined text-[14px]">surround_sound</span>
                                        Dolby Atmos
                                    </span>
                                    <span class="inline-flex items-center gap-1 bg-surface-container text-secondary px-2 py-1 rounded font-label-sm text-label-sm">
                                        <span class="material-symbols-outlined text-[14px]">meeting_room</span>
                                        Private Lounges
                                    </span>
                                    <span class="inline-flex items-center gap-1 bg-surface-container text-secondary px-2 py-1 rounded font-label-sm text-label-sm">
                                        <span class="material-symbols-outlined text-[14px]">wb_sunny</span>
                                        Sea View Balcony
                                    </span>
                                    <span class="inline-flex items-center gap-1 bg-surface-container text-secondary px-2 py-1 rounded font-label-sm text-label-sm">
                                        <span class="material-symbols-outlined text-[14px]">airline_seat_flat</span>
                                        Zero-Gravity Seats
                                    </span>
                                    <span class="inline-flex items-center gap-1 bg-surface-container text-secondary px-2 py-1 rounded font-label-sm text-label-sm">
                                        <span class="material-symbols-outlined text-[14px]">local_bar</span>
                                        Concessions Bar
                                    </span>
                                }
                                else
                                {
                                    <span class="inline-flex items-center gap-1 bg-surface-container text-primary px-2.5 py-1 rounded font-label-sm text-label-sm uppercase tracking-wider font-semibold shadow-sm">
                                        <span class="material-symbols-outlined text-[14px]">lens_blur</span>
                                        4K Dual Laser
                                    </span>
                                    <span class="inline-flex items-center gap-1 bg-surface-container text-secondary px-2 py-1 rounded font-label-sm text-label-sm">
                                        <span class="material-symbols-outlined text-[14px]">surround_sound</span>
                                        Dolby Atmos
                                    </span>
                                    <span class="inline-flex items-center gap-1 bg-surface-container text-secondary px-2 py-1 rounded font-label-sm text-label-sm">
                                        <span class="material-symbols-outlined text-[14px]">airline_seat_recline_extra</span>
                                        Recliner Seats
                                    </span>
                                    <span class="inline-flex items-center gap-1 bg-surface-container text-secondary px-2 py-1 rounded font-label-sm text-label-sm">
                                        <span class="material-symbols-outlined text-[14px]">restaurant_menu</span>
                                        Gourmet Dine-In
                                    </span>
                                    <span class="inline-flex items-center gap-1 bg-surface-container text-secondary px-2 py-1 rounded font-label-sm text-label-sm">
                                        <span class="material-symbols-outlined text-[14px]">directions_car</span>
                                        Valet Parking
                                    </span>
                                    <span class="inline-flex items-center gap-1 bg-surface-container text-secondary px-2 py-1 rounded font-label-sm text-label-sm">
                                        <span class="material-symbols-outlined text-[14px]">accessible</span>
                                        Wheelchair Accessible
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="grid grid-cols-2 gap-space-sm pt-space-xs mt-auto">
                            <a class="w-full text-center bg-primary-container hover:bg-inverse-primary text-on-primary-container font-label-md text-label-md py-2.5 rounded-lg transition-all shadow-[0_0_12px_rgba(229,9,20,0.35)] hover:shadow-[0_0_18px_rgba(229,9,20,0.55)]"
                               asp-controller="Cinemas" asp-action="Details" asp-route-id="@cinema.Id">
                                View Showtimes
                            </a>
                            <button class="branch-select-btn w-full text-center bg-surface-container hover:bg-surface-bright text-on-surface font-label-md text-label-md py-2.5 rounded-lg transition-colors flex items-center justify-center gap-1"
                                    data-branch-name="@cinema.Name"
                                    onclick="handleSelectBranch(this, '@cinema.Name')"
                                    type="button">
                                <span class="material-symbols-outlined text-[16px]">bookmark_add</span>
                                <span class="select-label">Select Branch</span>
                            </button>
                        </div>
                    </div>
                </article>
            }
        </div>

        <!-- Empty State Container (Hidden by default) -->
        <div class="hidden flex-col items-center justify-center py-16 px-space-md text-center bg-surface-container-low rounded-xl shadow-inner mt-space-md"
             id="no-results">
            <div class="w-16 h-16 rounded-full bg-surface-container flex items-center justify-center text-secondary mb-space-md">
                <span class="material-symbols-outlined text-4xl text-primary-container">search_off</span>
            </div>
            <h3 class="font-headline-md text-headline-md text-on-surface mb-space-xs">No cinemas found</h3>
            <p class="font-body-md text-body-md text-secondary max-w-md mb-space-lg">
                We couldn’t find any StarLight venues matching your search terms or location filter. Try clearing your search or switching cities.
            </p>
            <button class="px-space-lg py-3 bg-primary-container hover:bg-inverse-primary text-on-primary-container font-label-md text-label-md rounded-lg shadow-[0_0_16px_rgba(229,9,20,0.4)] transition-all flex items-center gap-space-xs"
                    onclick="resetAllFilters()"
                    type="button">
                <span class="material-symbols-outlined text-[18px]">replay</span>
                <span>Reset Filters &amp; Show All</span>
            </button>
        </div>
    </section>

    <!-- Interactive Map & Directions Section -->
    <section class="w-full px-gutter-mobile md:px-margin py-space-lg">
        <div class="bg-surface-container-low rounded-xl p-space-lg flex flex-col gap-space-lg shadow-md relative overflow-hidden">
            <!-- Ambient Glow -->
            <div class="absolute -right-20 -bottom-20 w-80 h-80 bg-primary-container/10 blur-[100px] pointer-events-none rounded-full"></div>

            <!-- Header row -->
            <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-space-md">
                <div class="flex flex-col gap-space-xs">
                    <div class="flex items-center gap-space-xs text-tertiary font-label-sm text-label-sm uppercase tracking-wider">
                        <span class="material-symbols-outlined text-[16px]">map</span>
                        <span>Live Cinema Locator</span>
                    </div>
                    <h3 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">Find Your Nearest StarLight</h3>
                    <p class="font-body-md text-body-md text-secondary max-w-xl">
                        The map shows all StarLight locations. Click <strong class="text-on-surface">Find Nearest</strong> to detect your position and highlight the closest branch automatically.
                    </p>
                </div>
                <div class="flex flex-wrap items-center gap-space-sm shrink-0">
                    <button id="locate-me-btn"
                            class="flex items-center gap-space-xs px-space-md py-2.5 bg-primary-container hover:bg-inverse-primary text-on-primary-container font-label-md text-label-md rounded-lg shadow-[0_0_16px_rgba(229,9,20,0.4)] transition-all cursor-pointer"
                            type="button">
                        <span class="material-symbols-outlined text-[18px]">my_location</span>
                        <span>Find Nearest Cinema</span>
                    </button>
                    <button id="reset-map-btn"
                            class="flex items-center gap-space-xs px-space-md py-2.5 bg-surface-container hover:bg-surface-bright text-secondary hover:text-on-surface font-label-md text-label-md rounded-lg transition-colors cursor-pointer"
                            type="button">
                        <span class="material-symbols-outlined text-[18px]">zoom_out_map</span>
                        <span>Reset View</span>
                    </button>
                </div>
            </div>

            <!-- Status bar -->
            <div id="map-status-bar" class="hidden items-center gap-space-xs px-space-md py-2.5 rounded-lg bg-surface-container border border-surface-container-highest/60 font-body-sm text-body-sm text-secondary">
                <span class="material-symbols-outlined text-[16px]" id="map-status-icon">info</span>
                <span id="map-status-text">Detecting your location…</span>
            </div>

            <!-- Nearest Cinema Info Panel (hidden until found) -->
            <div id="nearest-panel" class="hidden items-center gap-space-md p-space-md rounded-lg bg-surface-container border border-primary-container/40 shadow-[0_0_20px_rgba(229,9,20,0.15)]">
                <span class="material-symbols-outlined text-primary-container text-[28px] shrink-0">theater_comedy</span>
                <div class="flex-1">
                    <p class="font-label-sm text-label-sm uppercase tracking-wider text-primary-container mb-0.5">Nearest StarLight to You</p>
                    <p class="font-headline-sm text-headline-sm text-on-surface" id="nearest-name"></p>
                    <p class="font-body-sm text-body-sm text-secondary" id="nearest-detail"></p>
                </div>
                <a id="nearest-directions-link"
                   class="shrink-0 flex items-center gap-1.5 px-space-md py-2 bg-primary-container/20 hover:bg-primary-container/30 border border-primary-container/50 text-primary font-label-md text-label-md rounded-lg transition-all"
                   href="#" target="_blank" rel="noopener noreferrer">
                    <span class="material-symbols-outlined text-[16px]">directions</span>
                    <span>Get Directions</span>
                </a>
            </div>

            <!-- The Leaflet map container -->
            <div id="cinemas-map" class="w-full rounded-lg overflow-hidden shadow-inner" style="height:420px; background:#1a1a1a;"></div>
        </div>
    </section>

    <!-- Premiere Experience Callout Banner -->
    <section class="w-full px-gutter-mobile md:px-margin pt-space-sm pb-space-xl">
        <div class="relative w-full rounded-xl overflow-hidden bg-surface-container-low shadow-xl">
            <!-- Background Ambient Glow & Contrast Gradients -->
            <div class="absolute inset-0 bg-gradient-to-r from-primary-container/20 via-surface-container-high/40 to-surface-container-lowest pointer-events-none"></div>
            <div class="absolute -left-20 top-1/2 -translate-y-1/2 w-64 h-64 bg-primary-container/25 blur-[90px] pointer-events-none rounded-full"></div>
            <div class="relative z-10 px-space-lg md:px-space-xl py-space-xl flex flex-col md:flex-row items-center justify-between gap-space-lg">
                <div class="flex flex-col gap-space-xs text-center md:text-left max-w-2xl">
                    <div class="flex items-center justify-center md:justify-start gap-space-xs">
                        <span class="material-symbols-outlined text-primary-container text-[20px]">verified</span>
                        <span class="font-label-sm text-label-sm uppercase tracking-widest text-primary-container font-bold">Uncompromising Presentation</span>
                    </div>
                    <h2 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">
                        Next-Gen Dolby Atmos &amp; Dual 4K Laser
                    </h2>
                    <p class="font-body-md text-body-md text-secondary">
                        Step into crystal-clear acoustics and breathtaking contrast. Explore our schedule to lock in prime auditorium seats before upcoming blockbusters sell out.
                    </p>
                </div>
                <div class="flex flex-col sm:flex-row items-center gap-space-sm w-full md:w-auto shrink-0">
                    <a class="w-full sm:w-auto px-space-xl py-3.5 bg-primary-container hover:bg-inverse-primary text-on-primary-container font-label-lg text-label-lg rounded-lg shadow-[0_0_20px_rgba(229,9,20,0.5)] transition-all text-center"
                       asp-controller="Movies" asp-action="Index">
                        Explore Movies &amp; Book
                    </a>
                    <a class="w-full sm:w-auto px-space-lg py-3.5 bg-surface-container hover:bg-surface-bright text-on-surface font-label-lg text-label-lg rounded-lg transition-colors text-center"
                       asp-controller="Cinemas" asp-action="Index">
                        Auditorium Formats
                    </a>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <!-- Leaflet CSS & JS (dark tile via CartoDB dark matter) -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <style>
        /* Dark override for Leaflet UI controls */
        .leaflet-container { background: #1a1a1a; }
        .leaflet-bar a, .leaflet-bar a:hover { background: #201f1f; color: #e5e2e1; border-color: #353534; }
        .leaflet-bar a:hover { background: #2a2a2a; }
        .leaflet-popup-content-wrapper { background: #1c1b1b; color: #e5e2e1; border: 1px solid #353534; border-radius: 12px; box-shadow: 0 0 24px rgba(229,9,20,0.2); }
        .leaflet-popup-tip { background: #1c1b1b; }
        .leaflet-popup-content { margin: 12px 16px; }
        /* Pulsing dot for user location */
        @@keyframes pulse-ring { 0% { transform: scale(0.6); opacity: 1; } 100% { transform: scale(2.0); opacity: 0; } }
        .user-pulse-ring { animation: pulse-ring 1.6s ease-out infinite; }
        /* Nearest marker glow */
        @@keyframes nearest-glow { 0%,100% { filter: drop-shadow(0 0 6px rgba(229,9,20,0.9)); } 50% { filter: drop-shadow(0 0 14px rgba(229,9,20,0.4)); } }
        .nearest-icon { animation: nearest-glow 2s ease-in-out infinite; }
    </style>
    <script>
    (function initCinemaFilters() {
        const searchInput = document.getElementById('cinema-search');
        const citySelect = document.getElementById('city-filter');
        const formatPills = document.querySelectorAll('.format-pill');
        const clearBtn = document.getElementById('reset-filter-btn');
        const previewEmptyBtn = document.getElementById('simulate-empty-btn');
        const cinemaCards = document.querySelectorAll('[data-cinema-card]');
        const noResultsBox = document.getElementById('no-results');
        const countEl = document.getElementById('cinema-count');

        let currentFormat = 'all';

        function applyFilters() {
            const query = (searchInput?.value || '').toLowerCase().trim();
            const selectedCity = citySelect?.value || 'all';
            let visibleCount = 0;
            cinemaCards.forEach(card => {
                const cardName = (card.getAttribute('data-name') || '').toLowerCase();
                const cardCity = (card.getAttribute('data-city') || '').toLowerCase();
                const cardFormats = card.getAttribute('data-formats') || '';
                const matchesQuery = !query || cardName.includes(query) || cardCity.includes(query);
                const matchesCity = (selectedCity === 'all') || cardCity.includes(selectedCity.toLowerCase());
                const matchesFormat = (currentFormat === 'all') || cardFormats.includes(currentFormat);
                if (matchesQuery && matchesCity && matchesFormat) { card.classList.remove('hidden'); visibleCount++; }
                else { card.classList.add('hidden'); }
            });
            if (countEl) countEl.textContent = visibleCount;
            if (visibleCount === 0) { noResultsBox?.classList.remove('hidden'); noResultsBox?.classList.add('flex'); }
            else { noResultsBox?.classList.add('hidden'); noResultsBox?.classList.remove('flex'); }
        }

        searchInput?.addEventListener('input', applyFilters);
        citySelect?.addEventListener('change', applyFilters);
        formatPills.forEach(pill => {
            pill.addEventListener('click', () => {
                formatPills.forEach(p => { p.classList.remove('bg-primary-container','text-on-primary-container','shadow-[0_0_12px_rgba(229,9,20,0.4)]'); p.classList.add('bg-surface-container','text-secondary'); });
                pill.classList.remove('bg-surface-container','text-secondary');
                pill.classList.add('bg-primary-container','text-on-primary-container','shadow-[0_0_12px_rgba(229,9,20,0.4)]');
                currentFormat = pill.getAttribute('data-format') || 'all';
                applyFilters();
            });
        });
        window.resetAllFilters = function() {
            if (searchInput) searchInput.value = '';
            if (citySelect) citySelect.value = 'all';
            currentFormat = 'all';
            formatPills.forEach((p, idx) => {
                if (idx === 0) { p.classList.remove('bg-surface-container','text-secondary'); p.classList.add('bg-primary-container','text-on-primary-container','shadow-[0_0_12px_rgba(229,9,20,0.4)]'); }
                else { p.classList.remove('bg-primary-container','text-on-primary-container','shadow-[0_0_12px_rgba(229,9,20,0.4)]'); p.classList.add('bg-surface-container','text-secondary'); }
            });
            applyFilters();
        };
        clearBtn?.addEventListener('click', window.resetAllFilters);
        previewEmptyBtn?.addEventListener('click', () => {
            const isHidden = noResultsBox?.classList.contains('hidden');
            if (isHidden) { cinemaCards.forEach(c => c.classList.add('hidden')); noResultsBox?.classList.remove('hidden'); noResultsBox?.classList.add('flex'); if (countEl) countEl.textContent = '0'; }
            else { window.resetAllFilters(); }
        });
    })();

    // ============================================================
    // INTERACTIVE LEAFLET MAP
    // ============================================================
    (function initInteractiveMap() {
        // Embed cinema data from the Razor model as JSON
        const CINEMAS_DATA = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model?.Select(c => new { id = c.Id, name = c.Name, city = c.City, address = c.Address, lat = (double)c.Latitude, lng = (double)c.Longitude }) ?? Enumerable.Empty<object>()
        ));

        // Default map center — Cairo region
        const DEFAULT_CENTER = [30.0444, 31.2357];
        const DEFAULT_ZOOM = 9;

        const map = L.map('cinemas-map', {
            center: DEFAULT_CENTER,
            zoom: DEFAULT_ZOOM,
            zoomControl: true,
            scrollWheelZoom: true
        });

        // Dark base tile (CartoDB Dark Matter — free, no API key needed)
        L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> &copy; <a href="https://carto.com/">CARTO</a>',
            subdomains: 'abcd',
            maxZoom: 19
        }).addTo(map);

        // Custom SVG icons
        function makeCinemaIcon(isNearest) {
            const color = isNearest ? '#e50914' : '#c8c6c5';
            const glowClass = isNearest ? 'nearest-icon' : '';
            return L.divIcon({
                className: '',
                html: `<div class="${glowClass}" style="width:32px;height:40px;">
                    <svg viewBox="0 0 32 40" xmlns="http://www.w3.org/2000/svg">
                        <path d="M16 0C9.373 0 4 5.373 4 12c0 9 12 28 12 28S28 21 28 12C28 5.373 22.627 0 16 0z" fill="${color}"/>
                        <circle cx="16" cy="12" r="6" fill="${isNearest ? '#fff' : '#1c1b1b'}"/>
                        ${isNearest ? '<path d="M13 12l2 2 4-4" stroke="#e50914" stroke-width="2" fill="none" stroke-linecap="round"/>' : ''}
                    </svg>
                </div>`,
                iconSize: [32, 40],
                iconAnchor: [16, 40],
                popupAnchor: [0, -42]
            });
        }

        function makeUserIcon() {
            return L.divIcon({
                className: '',
                html: `<div style="position:relative;width:20px;height:20px;">
                    <div class="user-pulse-ring" style="position:absolute;inset:0;border-radius:50%;background:rgba(229,9,20,0.35);border:2px solid #e50914;"></div>
                    <div style="position:absolute;inset:4px;border-radius:50%;background:#e50914;"></div>
                </div>`,
                iconSize: [20, 20],
                iconAnchor: [10, 10],
                popupAnchor: [0, -14]
            });
        }

        // Place all cinema markers
        const markers = {};
        const bounds = [];

        CINEMAS_DATA.forEach(cinema => {
            if (!cinema.lat || !cinema.lng) return;
            const marker = L.marker([cinema.lat, cinema.lng], { icon: makeCinemaIcon(false) })
                .addTo(map)
                .bindPopup(`
                    <div style="min-width:200px;">
                        <p style="font-size:13px;font-weight:700;color:#e5e2e1;margin:0 0 4px;">${cinema.name}</p>
                        <p style="font-size:11px;color:#c8c6c5;margin:0 0 8px;">${cinema.address}, ${cinema.city}</p>
                        <a href="/Cinemas/Details/${cinema.id}"
                           style="display:inline-block;padding:5px 12px;background:#e50914;color:#fff;font-size:11px;font-weight:600;border-radius:6px;text-decoration:none;">
                            View Showtimes
                        </a>
                    </div>
                `);
            markers[cinema.id] = { marker, cinema };
            bounds.push([cinema.lat, cinema.lng]);
        });

        if (bounds.length > 0) {
            map.fitBounds(bounds, { padding: [40, 40] });
        }

        // State
        let userMarker = null;
        let nearestMarker = null;
        let highlightedId = null;

        // UI elements
        const locateBtn = document.getElementById('locate-me-btn');
        const resetBtn = document.getElementById('reset-map-btn');
        const statusBar = document.getElementById('map-status-bar');
        const statusIcon = document.getElementById('map-status-icon');
        const statusText = document.getElementById('map-status-text');
        const nearestPanel = document.getElementById('nearest-panel');
        const nearestName = document.getElementById('nearest-name');
        const nearestDetail = document.getElementById('nearest-detail');
        const nearestDirLink = document.getElementById('nearest-directions-link');

        function showStatus(icon, text, type) {
            statusBar.classList.remove('hidden');
            statusBar.classList.add('flex');
            statusIcon.textContent = icon;
            statusText.textContent = text;
            // type: 'info' | 'success' | 'error'
            statusBar.style.borderColor = type === 'error' ? 'rgba(229,9,20,0.5)' : type === 'success' ? 'rgba(70,211,105,0.4)' : 'rgba(53,53,52,0.6)';
            statusBar.style.color = type === 'error' ? '#ffb4aa' : type === 'success' ? '#46D369' : '#c8c6c5';
        }

        function highlightNearest(cinemaData) {
            // Reset previous highlight
            if (highlightedId !== null && markers[highlightedId]) {
                markers[highlightedId].marker.setIcon(makeCinemaIcon(false));
            }
            highlightedId = cinemaData.id;
            if (markers[cinemaData.id]) {
                markers[cinemaData.id].marker.setIcon(makeCinemaIcon(true));
                markers[cinemaData.id].marker.openPopup();
            }
            // Update nearest panel
            nearestName.textContent = cinemaData.name;
            const dist = cinemaData.distanceKm != null ? ` — ${cinemaData.distanceKm.toFixed(1)} km away` : '';
            nearestDetail.textContent = `${cinemaData.address}, ${cinemaData.city}${dist}`;
            nearestDirLink.href = `https://maps.google.com/maps?daddr=${cinemaData.lat},${cinemaData.lng}`;
            nearestPanel.classList.remove('hidden');
            nearestPanel.classList.add('flex');
        }

        function calculateHaversineKm(lat1, lon1, lat2, lon2) {
            const R = 6371;
            const p = Math.PI / 180;
            const dLat = (lat2 - lat1) * p;
            const dLon = (lon2 - lon1) * p;
            const a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                      Math.cos(lat1 * p) * Math.cos(lat2 * p) *
                      Math.sin(dLon / 2) * Math.sin(dLon / 2);
            const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
            return R * c;
        }

        function locateAt(latitude, longitude, sourceLabel) {
            // Place / update user marker
            if (userMarker) {
                userMarker.setLatLng([latitude, longitude]);
            } else {
                userMarker = L.marker([latitude, longitude], { icon: makeUserIcon(), zIndexOffset: 1000 })
                    .addTo(map)
                    .bindPopup(`<b style="color:#e5e2e1;">${sourceLabel || 'Selected location'}</b><br/><span style="color:#c8c6c5;font-size:11px;">${latitude.toFixed(4)}°, ${longitude.toFixed(4)}°</span>`);
            }

            // Fetch nearest from backend API dynamically
            fetch(`/Cinemas/NearestJson?latitude=${latitude}&longitude=${longitude}`)
                .then(r => r.json())
                .then(data => {
                    if (!data) {
                        showStatus('warning', 'No cinemas found near you.', 'error');
                        return;
                    }
                    const midLat = (latitude + data.lat) / 2;
                    const midLng = (longitude + data.lng) / 2;
                    map.flyTo([midLat, midLng], 11, { duration: 1.5 });
                    highlightNearest(data);
                    showStatus('check_circle', `${sourceLabel || 'Location'}: ${latitude.toFixed(4)}°, ${longitude.toFixed(4)}° → Nearest: ${data.name} (${data.distanceKm} km away)`, 'success');
                })
                .catch(() => {
                    // Client-side fallback using exact Haversine formula
                    let nearest = null, minDist = Infinity;
                    CINEMAS_DATA.forEach(c => {
                        const dist = calculateHaversineKm(latitude, longitude, c.lat, c.lng);
                        if (dist < minDist) {
                            minDist = dist;
                            nearest = c;
                        }
                    });
                    if (nearest) {
                        const roundDist = Math.round(minDist * 10) / 10;
                        map.flyTo([nearest.lat, nearest.lng], 12, { duration: 1.5 });
                        highlightNearest({ ...nearest, distanceKm: roundDist });
                        showStatus('check_circle', `${sourceLabel || 'Location'}: ${latitude.toFixed(4)}°, ${longitude.toFixed(4)}° → Nearest: ${nearest.name} (${roundDist} km away)`, 'success');
                    }
                })
                .finally(() => {
                    if (locateBtn) {
                        locateBtn.disabled = false;
                        locateBtn.innerHTML = '<span class="material-symbols-outlined text-[18px]">my_location</span><span>Find Nearest Cinema</span>';
                    }
                });
        }

        // Map click allows testing nearest cinema dynamically for any location
        map.on('click', (e) => {
            const { lat, lng } = e.latlng;
            locateAt(lat, lng, 'Selected Map Location');
        });

        locateBtn?.addEventListener('click', () => {
            if (!navigator.geolocation) {
                showStatus('location_off', 'Geolocation is not supported by your browser. Click anywhere on the map to set your location.', 'error');
                return;
            }
            locateBtn.disabled = true;
            locateBtn.innerHTML = '<span class="material-symbols-outlined text-[18px] animate-spin" style="animation:spin 1s linear infinite;">progress_activity</span><span>Locating…</span>';
            showStatus('location_searching', 'Requesting your location…', 'info');

            navigator.geolocation.getCurrentPosition(
                (pos) => {
                    const { latitude, longitude, accuracy } = pos.coords;
                    const accuracyLabel = accuracy ? ` (±${Math.round(accuracy)}m)` : '';
                    locateAt(latitude, longitude, `Detected Location${accuracyLabel}`);
                },
                (err) => {
                    locateBtn.disabled = false;
                    locateBtn.innerHTML = '<span class="material-symbols-outlined text-[18px]">my_location</span><span>Find Nearest Cinema</span>';
                    const msg = err.code === 1 
                        ? 'Location access denied in browser. Click any spot on the map to set your location directly.' 
                        : 'Could not determine location. Click any spot on the map to set your location directly.';
                    showStatus('location_off', msg, 'error');
                },
                { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 }
            );
        });

        resetBtn?.addEventListener('click', () => {
            if (bounds.length > 0) map.fitBounds(bounds, { padding: [40, 40] });
            if (userMarker) { map.removeLayer(userMarker); userMarker = null; }
            if (highlightedId !== null && markers[highlightedId]) {
                markers[highlightedId].marker.setIcon(makeCinemaIcon(false));
                markers[highlightedId].marker.closePopup();
                highlightedId = null;
            }
            nearestPanel.classList.add('hidden');
            nearestPanel.classList.remove('flex');
            statusBar.classList.add('hidden');
            statusBar.classList.remove('flex');
        });

        // Wire cinema card "Select Branch" buttons to fly-to that cinema on the map
        window.handleSelectBranch = function(btn, branchName) {
            // Find cinema by name
            const entry = Object.values(markers).find(m => m.cinema.name === branchName);
            if (entry) {
                map.flyTo([entry.cinema.lat, entry.cinema.lng], 14, { duration: 1.4 });
                setTimeout(() => entry.marker.openPopup(), 1500);
                document.getElementById('cinemas-map')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
            // Toggle selected state on button
            document.querySelectorAll('.branch-select-btn').forEach(b => {
                const lbl = b.querySelector('.select-label');
                const ico = b.querySelector('.material-symbols-outlined');
                b.classList.remove('bg-primary-container','text-on-primary-container','shadow-[0_0_12px_rgba(229,9,20,0.35)]');
                b.classList.add('bg-surface-container','text-on-surface');
                if (lbl) lbl.textContent = 'Select Branch';
                if (ico) ico.textContent = 'bookmark_add';
            });
            btn.classList.remove('bg-surface-container','text-on-surface');
            btn.classList.add('bg-primary-container','text-on-primary-container','shadow-[0_0_12px_rgba(229,9,20,0.35)]');
            const lbl = btn.querySelector('.select-label');
            const ico = btn.querySelector('.material-symbols-outlined');
            if (lbl) lbl.textContent = 'Selected!';
            if (ico) ico.textContent = 'bookmark_added';
        };

        // Spin keyframe for the loading icon
        if (!document.getElementById('spin-style')) {
            const s = document.createElement('style');
            s.id = 'spin-style';
            s.textContent = '@@keyframes spin { to { transform: rotate(360deg); } }';
            document.head.appendChild(s);
        }
    })();
    </script>
}


