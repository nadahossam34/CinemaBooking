@model ProfileViewModel
@{
    ViewData["Title"] = "My Profile";
    var bookings = Model.Bookings ?? new List<Booking>();
    var upcomingCount = bookings.Count(b => b.Showtime?.Date >= DateOnly.FromDateTime(DateTime.Today));
}

<div class="flex flex-col w-full">
    <div class="w-full max-w-7xl mx-auto px-gutter-mobile md:px-margin py-space-xl flex flex-col gap-space-xl">

        <!-- ════════════════════════════════════════════
             PROFILE HEADER SECTION
        ════════════════════════════════════════════ -->
        <div class="relative w-full rounded-xl bg-surface-container-low border border-surface-container-highest/60 p-space-lg md:p-space-xl shadow-xl overflow-hidden">
            <!-- Ambient Theatrical Glow Backing -->
            <div class="absolute -top-24 -right-24 w-96 h-96 rounded-full bg-primary-container/10 blur-3xl pointer-events-none"></div>

            <div class="relative z-10 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-space-lg">
                <!-- User Info & Identifiers -->
                <div class="flex flex-col gap-space-xs">
                    <div class="flex flex-wrap items-center gap-space-sm">
                        <h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">@Model.Name</h1>
                        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-surface-container border border-primary-container/60 text-primary font-label-sm text-label-sm uppercase tracking-wider">
                            @if (Model.IsAdmin)
                            {
                                <span class="material-symbols-outlined text-[14px] text-primary" style="font-variation-settings: 'FILL' 1;">shield</span>
                                <span>System Administrator</span>
                            }
                            else
                            {
                                <span class="material-symbols-outlined text-[14px] text-primary" style="font-variation-settings: 'FILL' 1;">star</span>
                                <span>Premiere VIP Member</span>
                            }
                        </div>
                    </div>
                    <p class="font-body-md text-body-md text-secondary">@Model.Email</p>
                    <div class="flex items-center gap-space-xs text-secondary mt-1 font-body-sm text-body-sm">
                        <span class="material-symbols-outlined text-[15px]">calendar_today</span>
                        <span>Member since @Model.CreatedAt.ToString("MMMM yyyy")</span>
                    </div>
                </div>

                <!-- Header Actions -->
                <div class="flex flex-col sm:flex-row lg:flex-col xl:flex-row items-start sm:items-center gap-space-md w-full lg:w-auto justify-between pt-space-sm lg:pt-0">
                    <div class="flex flex-wrap items-center gap-space-sm">
                        @if (Model.IsAdmin)
                        {
                            <a asp-controller="Admin" asp-action="Index"
                               class="flex items-center gap-space-xs px-space-md py-2.5 bg-primary-container/20 hover:bg-primary-container/30 border border-primary-container/50 text-primary rounded-lg font-label-md text-label-md transition-all shadow-[0_0_12px_rgba(229,9,20,0.25)]">
                                <span class="material-symbols-outlined text-[18px]">admin_panel_settings</span>
                                Admin Panel
                            </a>
                        }
                        <form asp-controller="Account" asp-action="Logout" method="post" class="inline">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="flex items-center gap-space-xs px-space-md py-2.5 bg-surface-container hover:bg-error-container/20 border border-surface-container-highest hover:border-error/40 text-secondary hover:text-error rounded-lg font-label-md text-label-md transition-all cursor-pointer">
                                <span class="material-symbols-outlined text-[18px]">logout</span>
                                Logout
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- ════════════════════════════════════════════
             MAIN CONTENT 2-COLUMN RESPONSIVE LAYOUT
        ════════════════════════════════════════════ -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-space-xl items-start">

            <!-- ── LEFT COLUMN: Account Details & Edit Profile (5 cols) ── -->
            <div class="lg:col-span-5 flex flex-col gap-space-xl">

                <!-- Account Overview Card -->
                <div class="flex flex-col rounded-xl bg-surface-container-low border border-surface-container-highest/60 overflow-hidden shadow-lg">
                    <div class="px-space-lg py-space-md bg-surface-container/60 border-b border-surface-container-highest/40 flex items-center justify-between">
                        <div class="flex items-center gap-space-sm">
                            <span class="material-symbols-outlined text-primary-container">badge</span>
                            <h2 class="font-headline-sm text-headline-sm text-on-surface">Account Information</h2>
                        </div>
                        <span class="font-label-sm text-label-sm uppercase tracking-wider px-2 py-0.5 rounded bg-surface-container-highest text-secondary">Read-only view</span>
                    </div>

                    <div class="p-space-lg flex flex-col gap-space-lg">
                        <!-- Legal Full Name -->
                        <div class="flex flex-col gap-1 pb-space-md border-b border-surface-container-highest/40">
                            <span class="font-label-sm text-label-sm text-secondary uppercase tracking-wider">Legal Full Name</span>
                            <span class="font-body-lg text-body-lg text-on-surface font-semibold">@Model.Name</span>
                        </div>

                        <!-- Email Address -->
                        <div class="flex flex-col gap-1 pb-space-md border-b border-surface-container-highest/40">
                            <div class="flex items-center justify-between">
                                <span class="font-label-sm text-label-sm text-secondary uppercase tracking-wider">Email Address</span>
                                <span class="inline-flex items-center gap-1 text-[11px] font-semibold text-[#46D369] bg-[#46D369]/10 px-2 py-0.5 rounded">
                                    <span class="material-symbols-outlined text-[13px]" style="font-variation-settings: 'FILL' 1;">check_circle</span>
                                    Verified
                                </span>
                            </div>
                            <span class="font-body-md text-body-md text-on-surface">@Model.Email</span>
                        </div>

                        <!-- Home Cinema & Preferred Auditorium -->
                        <div class="flex flex-col gap-1 pb-space-md border-b border-surface-container-highest/40">
                            <span class="font-label-sm text-label-sm text-secondary uppercase tracking-wider">Home Cinema &amp; Preferred Auditorium</span>
                            <div class="flex items-center gap-space-xs mt-0.5">
                                <span class="material-symbols-outlined text-primary-container text-[18px]">location_on</span>
                                <span class="font-body-md text-body-md text-on-surface font-medium">StarLight Grand Luxe (Auditorium 1, IMAX)</span>
                            </div>
                        </div>

                        <!-- Membership Classification -->
                        <div class="flex items-center justify-between pt-space-xs">
                            <div>
                                <span class="font-label-sm text-label-sm text-secondary uppercase tracking-wider block">Membership Classification</span>
                                <span class="font-headline-sm text-headline-sm text-tertiary">@(Model.IsAdmin ? "System Administrator" : "Gold Premiere Patron")</span>
                            </div>
                            <div class="w-10 h-10 rounded-lg bg-tertiary-container/20 flex items-center justify-center text-tertiary">
                                <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1;">military_tech</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Edit Profile Section & Interactive Form -->
                <div class="flex flex-col rounded-xl bg-surface-container-low border border-surface-container-highest/60 overflow-hidden shadow-lg" id="editProfileSection">
                    <div class="px-space-lg py-space-md bg-surface-container/60 border-b border-surface-container-highest/40 flex items-center justify-between">
                        <div class="flex items-center gap-space-sm">
                            <span class="material-symbols-outlined text-primary-container">edit_square</span>
                            <h2 class="font-headline-sm text-headline-sm text-on-surface">Edit Profile</h2>
                        </div>
                        <span class="font-body-sm text-body-sm text-secondary">Instant Sync</span>
                    </div>

                    <form class="p-space-lg flex flex-col gap-space-md" id="profileUpdateForm" method="post" asp-controller="Account" asp-action="UpdateProfile">
                        @Html.AntiForgeryToken()

                        <div class="flex flex-col gap-space-xs">
                            <label class="font-label-md text-label-md text-on-surface-variant" for="fullNameInput">Full Name</label>
                            <div class="relative">
                                <input name="fullName" class="w-full bg-surface-container border border-surface-container-highest rounded-lg px-space-md py-2.5 font-body-md text-body-md text-on-surface focus:outline-none focus:border-primary-container focus:ring-1 focus:ring-primary-container transition-all"
                                       id="fullNameInput" type="text" value="@Model.Name" required />
                                <span class="material-symbols-outlined absolute right-3 top-2.5 text-secondary text-[20px]">person</span>
                            </div>
                        </div>

                        <div class="flex flex-col gap-space-xs">
                            <label class="font-label-md text-label-md text-on-surface-variant" for="emailInput">Email Address</label>
                            <div class="relative">
                                <input class="w-full bg-surface-container border border-surface-container-highest/50 rounded-lg px-space-md py-2.5 font-body-md text-body-md text-secondary cursor-not-allowed"
                                       id="emailInput" type="email" value="@Model.Email" readonly disabled />
                                <span class="material-symbols-outlined absolute right-3 top-2.5 text-secondary/60 text-[20px]">mail</span>
                            </div>
                        </div>

                        <!-- Success notification alert -->
                        <div class="@(TempData["SuccessMessage"] != null ? "" : "hidden") p-space-sm rounded-lg bg-primary-container/20 border border-primary-container/40 text-on-surface text-body-sm flex items-center gap-2" id="saveAlert">
                            <span class="material-symbols-outlined text-primary-container text-[18px]">check</span>
                            <span id="saveAlertText">@(TempData["SuccessMessage"] ?? "Profile preferences updated successfully.")</span>
                        </div>

                        <!-- Form Action Footer -->
                        <div class="flex items-center justify-end gap-space-sm pt-space-sm">
                            <button class="px-space-md py-2.5 rounded-lg bg-surface-container-highest/40 hover:bg-surface-container-highest text-secondary hover:text-on-surface font-label-lg text-label-lg transition-colors cursor-pointer"
                                    type="button" onclick="document.getElementById('fullNameInput').value = '@Model.Name';">
                                Cancel
                            </button>
                            <button class="px-space-lg py-2.5 rounded-lg bg-primary-container hover:bg-[#b20710] text-on-primary-container font-label-lg text-label-lg transition-all shadow-[0_0_16px_rgba(229,9,20,0.35)] flex items-center gap-1.5 cursor-pointer"
                                    type="submit">
                                <span class="material-symbols-outlined text-[18px]">save</span>
                                Save Changes
                            </button>
                        </div>
                    </form>
                </div>

            </div>

            <!-- ── RIGHT COLUMN: My Bookings (7 cols) ── -->
            <div class="lg:col-span-7 flex flex-col gap-space-lg">

                <!-- Booking Segment Tabs / Header -->
                <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-space-md border-b border-surface-container-highest/60 pb-space-sm">
                    <div class="flex items-center gap-space-sm">
                        <span class="material-symbols-outlined text-primary-container text-headline-sm">confirmation_number</span>
                        <h2 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">My Bookings</h2>
                    </div>
                    <div class="inline-flex rounded-lg p-1 bg-surface-container border border-surface-container-highest/80 self-start sm:self-auto">
                        <a asp-controller="Booking" asp-action="MyBookings"
                           class="px-space-md py-1.5 rounded-md font-label-md text-label-md transition-all text-secondary hover:text-on-surface flex items-center gap-1">
                            <span>Upcoming (@(bookings.Any() ? upcomingCount : 2))</span>
                        </a>
                    </div>
                </div>

                <!-- Bookings Cards Container -->
                <div class="flex flex-col gap-space-md">

                    @if (bookings.Any())
                    {
                        @foreach (var booking in bookings)
                        {
                            var isUpcoming = booking.Showtime?.Date >= DateOnly.FromDateTime(DateTime.Today);
                            var seatLabels = booking.BookingSeats != null && booking.BookingSeats.Any()
                                ? string.Join(", ", booking.BookingSeats.Select(bs => $"{bs.Seat?.RowLabel}{bs.Seat?.SeatNumber}"))
                                : "General Admission";
                            var movieTitle = booking.Showtime?.Movie?.Title ?? "Special Screening";
                            var poster = !string.IsNullOrEmpty(booking.Showtime?.Movie?.PosterUrl)
                                ? booking.Showtime.Movie.PosterUrl
                                : "https://lh3.googleusercontent.com/aida-public/AB6AXuCGE4kuzWFnprRnxeunu6N_kcFSliTz08gT2dWd5k_KTX3tmdvzKvOe4wb-20kvhPkXzeGkJrpqjfh4QhA7hx-XGCO4iZC0JVhUzzfDq2zjo8B_DaDGS4h-wccEVJuHEoWHZZ5lwUa1Dez1SmdXzuKjnql__7RlJtNjMKd0w8yWJ-UodKyIfBbKNr3R5flXjCxZVlkxBcgVArJfi1W40drBuu7wI53qsahXRiOeFadg23En-8suv4Wp6g";
                            var dateStr = booking.Showtime?.Date.ToString("MMM d, yyyy") ?? "—";
                            var timeStr = booking.Showtime?.Time.ToString("hh\\:mm tt") ?? "—";

                            <div class="p-space-md rounded-xl bg-surface-container-low border border-surface-container-highest/60 hover:border-surface-container-highest transition-all flex flex-col md:flex-row items-start md:items-center justify-between gap-space-md">
                                <div class="flex items-center gap-space-md">
                                    <div class="w-16 h-20 rounded-lg overflow-hidden bg-surface-container shrink-0">
                                        <img class="w-full h-full object-cover" src="@poster" alt="@movieTitle" />
                                    </div>
                                    <div class="flex flex-col gap-1">
                                        <div class="flex items-center gap-space-sm flex-wrap">
                                            <h4 class="font-headline-sm text-headline-sm text-on-surface">@movieTitle</h4>
                                            @if (isUpcoming)
                                            {
                                                <span class="px-2 py-0.5 rounded text-[11px] font-semibold uppercase bg-primary-container/20 text-primary border border-primary-container/50">
                                                    Upcoming
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="px-2 py-0.5 rounded text-[11px] font-semibold uppercase bg-surface-container-highest text-secondary">
                                                    Completed
                                                </span>
                                            }
                                        </div>
                                        <p class="font-body-sm text-body-sm text-secondary">@dateStr • @timeStr • @seatLabels</p>
                                        <span class="font-mono text-xs text-secondary-container">ID: #@(booking.BookingReference ?? "SLC-" + booking.Id)</span>
                                    </div>
                                </div>
                                <div class="flex items-center gap-space-xs self-end md:self-center">
                                    <a asp-controller="Booking" asp-action="Ticket" asp-route-bookingId="@booking.Id"
                                       class="px-3 py-1.5 rounded-lg bg-primary-container hover:bg-[#b20710] text-on-primary-container font-label-sm text-label-sm transition-colors flex items-center gap-1 shadow-sm">
                                        <span class="material-symbols-outlined text-[16px]">qr_code_2</span>
                                        <span>Ticket</span>
                                    </a>
                                    <a asp-controller="Movies" asp-action="Index"
                                       class="px-3 py-1.5 rounded-lg bg-surface-container hover:bg-surface-container-highest text-secondary hover:text-on-surface font-label-sm text-label-sm transition-colors flex items-center gap-1">
                                        <span class="material-symbols-outlined text-[16px]">replay</span>
                                        <span>Book Again</span>
                                    </a>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <!-- Reference Design Showcase Bookings -->
                        <!-- History Card 1: Blade Runner 2049 -->
                        <div class="p-space-md rounded-xl bg-surface-container-low border border-surface-container-highest/60 hover:border-surface-container-highest transition-all flex flex-col md:flex-row items-start md:items-center justify-between gap-space-md">
                            <div class="flex items-center gap-space-md">
                                <div class="w-16 h-20 rounded-lg overflow-hidden bg-surface-container shrink-0">
                                    <img class="w-full h-full object-cover"
                                         alt="Blade Runner 2049"
                                         src="https://lh3.googleusercontent.com/aida-public/AB6AXuCGE4kuzWFnprRnxeunu6N_kcFSliTz08gT2dWd5k_KTX3tmdvzKvOe4wb-20kvhPkXzeGkJrpqjfh4QhA7hx-XGCO4iZC0JVhUzzfDq2zjo8B_DaDGS4h-wccEVJuHEoWHZZ5lwUa1Dez1SmdXzuKjnql__7RlJtNjMKd0w8yWJ-UodKyIfBbKNr3R5flXjCxZVlkxBcgVArJfi1W40drBuu7wI53qsahXRiOeFadg23En-8suv4Wp6g" />
                                </div>
                                <div class="flex flex-col gap-1">
                                    <div class="flex items-center gap-space-sm flex-wrap">
                                        <h4 class="font-headline-sm text-headline-sm text-on-surface">Blade Runner 2049 — Retrospective</h4>
                                        <span class="px-2 py-0.5 rounded text-[11px] font-semibold uppercase bg-surface-container-highest text-secondary">
                                            Completed
                                        </span>
                                    </div>
                                    <p class="font-body-sm text-body-sm text-secondary">Sept 12, 2025 • 09:00 PM • Row D, Seats 8, 9</p>
                                    <span class="font-mono text-xs text-secondary-container">ID: #SLC-61204-VIP</span>
                                </div>
                            </div>
                            <div class="flex items-center gap-space-xs self-end md:self-center">
                                <button type="button" class="px-3 py-1.5 rounded-lg bg-surface-container hover:bg-surface-container-highest text-secondary hover:text-on-surface font-label-sm text-label-sm transition-colors flex items-center gap-1 cursor-pointer">
                                    <span class="material-symbols-outlined text-[16px] text-tertiary">star_rate</span>
                                    <span>Rate Screening</span>
                                </button>
                                <a asp-controller="Movies" asp-action="Index"
                                   class="px-3 py-1.5 rounded-lg bg-surface-container hover:bg-surface-container-highest text-secondary hover:text-on-surface font-label-sm text-label-sm transition-colors flex items-center gap-1">
                                    <span class="material-symbols-outlined text-[16px]">replay</span>
                                    <span>Book Again</span>
                                </a>
                            </div>
                        </div>

                        <!-- History Card 2: Interstellar -->
                        <div class="p-space-md rounded-xl bg-surface-container-low border border-surface-container-highest/60 hover:border-surface-container-highest transition-all flex flex-col md:flex-row items-start md:items-center justify-between gap-space-md">
                            <div class="flex items-center gap-space-md">
                                <div class="w-16 h-20 rounded-lg overflow-hidden bg-surface-container shrink-0">
                                    <img class="w-full h-full object-cover"
                                         alt="Interstellar"
                                         src="https://lh3.googleusercontent.com/aida-public/AB6AXuBAcRXwHh9EQeXKiHXfyG6GfnJwYXJEDKDx8isWvkv1epB_vF3ZAymbvRN8GCfEV9IpIVAee__z1qb-Z20P5c_be_A_mhjLcLM38xcGxGXJ460bleOBUBKDeyXV7JqQcwU4SvICXTQMwSjXUWkUgYpXOiPsAKa50kj7TVg29oRyJ8AprPLSlu2Qt-EAN8rAaExK1M8j3BHNmpgLLHPLIdP5GGCgeV3r5ZYYyKxNpS4EyQw_EOhQfyS1JQ" />
                                </div>
                                <div class="flex flex-col gap-1">
                                    <div class="flex items-center gap-space-sm flex-wrap">
                                        <h4 class="font-headline-sm text-headline-sm text-on-surface">Interstellar — 10th Anniversary</h4>
                                        <span class="px-2 py-0.5 rounded text-[11px] font-semibold uppercase bg-surface-container-highest text-secondary">
                                            Completed
                                        </span>
                                    </div>
                                    <p class="font-body-sm text-body-sm text-secondary">Aug 18, 2025 • 06:45 PM • Row E, Seat 12</p>
                                    <span class="font-mono text-xs text-secondary-container">ID: #SLC-52011-IMX</span>
                                </div>
                            </div>
                            <div class="flex items-center gap-space-xs self-end md:self-center">
                                <button type="button" class="px-3 py-1.5 rounded-lg bg-surface-container hover:bg-surface-container-highest text-secondary hover:text-on-surface font-label-sm text-label-sm transition-colors flex items-center gap-1 cursor-pointer">
                                    <span class="material-symbols-outlined text-[16px] text-tertiary">star_rate</span>
                                    <span>Rated 5/5</span>
                                </button>
                            </div>
                        </div>

                        <!-- History Card 3: Mission Impossible (Cancelled) -->
                        <div class="p-space-md rounded-xl bg-surface-container-low border border-surface-container-highest/40 opacity-80 hover:opacity-100 transition-all flex flex-col md:flex-row items-start md:items-center justify-between gap-space-md">
                            <div class="flex items-center gap-space-md">
                                <div class="w-16 h-20 rounded-lg overflow-hidden bg-surface-container shrink-0 relative">
                                    <img class="w-full h-full object-cover grayscale"
                                         alt="Mission: Impossible"
                                         src="https://lh3.googleusercontent.com/aida-public/AB6AXuCA_rKqRIKe7L7o9tp8MCxR9TtHhoRk1bVp9lUpTJ156jcA-_UaDyqaHnE-GyN2ED3z-jWVVTiT6RW9jwZWGCkqjlKb8rorNsXIO64FVEmZ9_q7s7QRIbDrfum1uIBWiijI9eisZJ_RL6Hmeiuxa8ueRGmT-sWXq_YB66lVI3PO-3sgEgSKv2e7SuKq-epcbvhnNP67iVknUhKJUiLN5VBW52bm5Noi7FW5bWV0G52pgHse8WgwFxFE2Q" />
                                    <div class="absolute inset-0 bg-surface-container-lowest/50"></div>
                                </div>
                                <div class="flex flex-col gap-1">
                                    <div class="flex items-center gap-space-sm flex-wrap">
                                        <h4 class="font-headline-sm text-headline-sm text-secondary line-through">Mission: Impossible — Dead Reckoning</h4>
                                        <span class="px-2 py-0.5 rounded text-[11px] font-semibold uppercase bg-primary-container/15 text-primary border border-primary-container/30">
                                            Cancelled
                                        </span>
                                    </div>
                                    <p class="font-body-sm text-body-sm text-secondary">July 05, 2025 • Refund Processed ($34.50)</p>
                                    <span class="font-mono text-xs text-secondary-container">ID: #SLC-44910-REF</span>
                                </div>
                            </div>
                            <div class="flex items-center gap-space-xs self-end md:self-center">
                                <span class="font-body-sm text-body-sm text-secondary italic">Full Refund Issued</span>
                            </div>
                        </div>
                    }

                </div>

            </div>

                </div></div>

    


@section Scripts {
    <script>
        (function () {
            const saveAlert = document.getElementById('saveAlert');
            if (saveAlert && !saveAlert.classList.contains('hidden')) {
                setTimeout(() => {
                    saveAlert.classList.add('hidden');
                }, 4000);
            }
        })();
    </script>
}
